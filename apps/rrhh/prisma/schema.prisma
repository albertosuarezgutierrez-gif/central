generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model empresas {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  marca_logo   String?
  marca_color  String?
  creada_at    DateTime @default(now()) @db.Timestamptz(6)
  usuarios     usuarios_rrhh[]
  empleados    empleados[]
}

model usuarios_rrhh {
  id          String   @id @default(uuid()) @db.Uuid
  empresa_id  String   @db.Uuid
  email       String   @unique
  pass_hash   String
  nombre      String
  session_jti String?
  creada_at   DateTime @default(now()) @db.Timestamptz(6)
  empresa     empresas @relation(fields: [empresa_id], references: [id])
}

model empleados {
  id            String    @id @default(uuid()) @db.Uuid
  empresa_id    String    @db.Uuid
  nombre        String
  dni           String?
  email         String?
  telefono      String?
  puesto        String?
  fecha_alta    DateTime? @db.Date
  estado        String    @default("activo")
  acceso_token  String    @unique
  pin_hash      String?
  creada_at     DateTime  @default(now()) @db.Timestamptz(6)
  empresa       empresas  @relation(fields: [empresa_id], references: [id])
  documentos    documentos[]

  @@index([empresa_id])
}

model documentos {
  id           String    @id @default(uuid()) @db.Uuid
  empresa_id   String    @db.Uuid
  empleado_id  String    @db.Uuid
  carpeta      String
  nombre       String
  tipo         String?
  tamano       BigInt?
  storage_path String
  subido_por   String
  caducidad    DateTime? @db.Date
  estado_firma String    @default("no_requiere")
  creada_at    DateTime  @default(now()) @db.Timestamptz(6)
  empleado     empleados @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@index([empleado_id])
  @@index([empresa_id])
}

model firma_otps {
  id           String   @id @default(uuid()) @db.Uuid
  empresa_id   String   @db.Uuid
  empleado_id  String   @db.Uuid
  documento_id String   @db.Uuid
  codigo_hash  String
  expira_at    DateTime @db.Timestamptz(6)
  intentos     Int      @default(0)
  creada_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([documento_id, empleado_id])
}

model firmas {
  id              String   @id @default(uuid()) @db.Uuid
  empresa_id      String   @db.Uuid
  empleado_id     String   @db.Uuid
  documento_id    String   @db.Uuid
  doc_hash        String
  algoritmo       String   @default("SHA-256")
  metodo          String
  firmante_nombre String
  firmante_email  String?
  firmante_dni    String?
  ip              String?
  user_agent      String?
  sello_tiempo    DateTime @db.Timestamptz(6)
  evidencia       Json
  creada_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([documento_id])
  @@index([empresa_id])
}
