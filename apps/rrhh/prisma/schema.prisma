generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model empresas {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  marca_logo   String?
  marca_color  String?
  cnae_codigo  String?
  at_ep_tipo   Decimal? @db.Decimal(6, 4)
  creada_at    DateTime @default(now()) @db.Timestamptz(6)
  usuarios     usuarios_rrhh[]
  empleados    empleados[]
}

model usuarios_rrhh {
  id          String   @id @default(uuid()) @db.Uuid
  empresa_id  String   @db.Uuid
  email       String   @unique
  pass_hash   String
  nombre      String
  session_jti String?
  creada_at   DateTime @default(now()) @db.Timestamptz(6)
  empresa     empresas @relation(fields: [empresa_id], references: [id])
}

model empleados {
  id            String    @id @default(uuid()) @db.Uuid
  empresa_id    String    @db.Uuid
  nombre        String
  apellidos     String?
  dni           String?
  nss           String?
  email         String?
  telefono      String?
  puesto        String?
  domicilio         String?
  localidad         String?
  provincia         String?
  fecha_nacimiento  DateTime? @db.Date
  estado_civil      String?
  tipo_contrato     String?
  centro_trabajo    String?
  cuenta_cotizacion String?
  categoria         String?
  grupo_cotizacion  String?
  tipo_jornada      String?
  fecha_alta        DateTime? @db.Date
  fecha_reconocimiento_medico DateTime? @db.Date
  estado            String    @default("activo")
  acceso_token  String    @unique
  pin_hash      String?
  creada_at     DateTime  @default(now()) @db.Timestamptz(6)
  empresa       empresas  @relation(fields: [empresa_id], references: [id])
  documentos    documentos[]

  @@index([empresa_id])
}

model documentos {
  id           String    @id @default(uuid()) @db.Uuid
  empresa_id   String    @db.Uuid
  empleado_id  String    @db.Uuid
  carpeta      String
  nombre       String
  tipo         String?
  tamano       BigInt?
  storage_path String
  subido_por   String
  caducidad    DateTime? @db.Date
  estado_firma             String    @default("no_requiere")
  requiere_firma_empresa   Boolean   @default(false)
  firmado_empresa_at       DateTime? @db.Timestamptz(6)
  firmado_empresa_nombre   String?
  firmado_empresa_hash     String?
  creada_at    DateTime  @default(now()) @db.Timestamptz(6)
  empleado     empleados @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@index([empleado_id])
  @@index([empresa_id])
}

model firma_otps {
  id           String   @id @default(uuid()) @db.Uuid
  empresa_id   String   @db.Uuid
  empleado_id  String   @db.Uuid
  documento_id String   @db.Uuid
  codigo_hash  String
  expira_at    DateTime @db.Timestamptz(6)
  intentos     Int      @default(0)
  creada_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([documento_id, empleado_id])
}

model firmas {
  id              String   @id @default(uuid()) @db.Uuid
  empresa_id      String   @db.Uuid
  empleado_id     String   @db.Uuid
  documento_id    String   @db.Uuid
  doc_hash        String
  algoritmo       String   @default("SHA-256")
  metodo          String
  firmante_nombre String
  firmante_email  String?
  firmante_dni    String?
  ip              String?
  user_agent      String?
  sello_tiempo    DateTime @db.Timestamptz(6)
  evidencia       Json
  creada_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([documento_id])
  @@index([empresa_id])
}

model contratos_laborales {
  id                 String   @id @default(uuid()) @db.Uuid
  empresa_id         String   @db.Uuid
  empleado_id        String   @db.Uuid
  salario_base       Decimal  @db.Decimal(10, 2)
  grupo_cotizacion   Int      @db.SmallInt
  tipo_contrato      String
  jornada_pct        Decimal  @default(100) @db.Decimal(5, 2)
  irpf_retencion_pct Decimal  @default(0) @db.Decimal(5, 2)
  categoria_convenio String?
  conceptos_fijos    Json     @default("[]")
  vigente_desde      DateTime @db.Date
  activo             Boolean  @default(true)
  creada_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([empresa_id])
  @@index([empleado_id])
}

model nominas {
  id            String    @id @default(uuid()) @db.Uuid
  empresa_id    String    @db.Uuid
  empleado_id   String    @db.Uuid
  periodo       String
  estado        String    @default("borrador")
  datos_calculo Json      @default("{}")
  pdf_path      String?
  generada_at   DateTime  @default(now()) @db.Timestamptz(6)
  confirmada_at DateTime? @db.Timestamptz(6)
  enviada_at    DateTime? @db.Timestamptz(6)
  creada_at     DateTime  @default(now()) @db.Timestamptz(6)
  incidencias   incidencias_mes[]

  @@unique([empresa_id, empleado_id, periodo])
  @@index([empresa_id, periodo])
}

model incidencias_mes {
  id         String   @id @default(uuid()) @db.Uuid
  empresa_id String   @db.Uuid
  nomina_id  String   @db.Uuid
  tipo       String
  concepto   String
  importe    Decimal? @db.Decimal(10, 2)
  horas      Decimal? @db.Decimal(6, 2)
  dias       Int?
  creada_at  DateTime @default(now()) @db.Timestamptz(6)
  nomina     nominas  @relation(fields: [nomina_id], references: [id], onDelete: Cascade)

  @@index([nomina_id])
}
