{
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs apps/rrhh",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npx --yes pnpm@10.33.0 install --no-frozen-lockfile",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/nominas",
      "schedule": "0 8 25 * *"
