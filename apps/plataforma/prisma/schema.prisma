generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cuenta {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String
  email        String
  passwordHash String?    @map("password_hash")
  sessionJti   String?    @map("session_jti")
  rol          String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  sociedades   Sociedad[]

  @@map("cuentas")
}

model Sociedad {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuentaId  String    @map("cuenta_id") @db.Uuid
  nombre    String
  cif       String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  cuenta    Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  negocios  Negocio[]

  @@map("sociedades")
}

model Negocio {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sociedadId     String   @map("sociedad_id") @db.Uuid
  nombre         String
  sector         String
  refExt         String?  @map("ref_ext")
  app            String?
  // Cifras manuales para negocios que NO están en ninguna app (financiero introducido a mano).
  // Si `app` es null y hay valores aquí, el dashboard los usa como su financiero.
  ingresosManual Decimal? @map("ingresos_manual") @db.Decimal
  gastosManual   Decimal? @map("gastos_manual") @db.Decimal
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sociedad       Sociedad @relation(fields: [sociedadId], references: [id], onDelete: Cascade)

  @@map("negocios")
}

model FiscalPerfil {
  cuentaId                 String   @id @map("cuenta_id") @db.Uuid
  comunidadAutonoma        String   @default("andalucia") @map("comunidad_autonoma")
  declaracionConjunta      Boolean  @default(true) @map("declaracion_conjunta")
  familiaNumerosa          String?  @map("familia_numerosa")
  conyugeTrabaja           Boolean  @default(false) @map("conyuge_trabaja")
  gastoGuarderiaAnual      Decimal  @default(0) @map("gasto_guarderia_anual") @db.Decimal
  aportacionPlanPensiones  Decimal  @default(0) @map("aportacion_plan_pensiones") @db.Decimal
  gradoDiscapacidadTitular Int      @default(0) @map("grado_discapacidad_titular")
  gradoDiscapacidadConyuge Int      @default(0) @map("grado_discapacidad_conyuge")
  ascendientesACargo       Int      @default(0) @map("ascendientes_a_cargo")
  ascendientesMayores75    Int      @default(0) @map("ascendientes_mayores_75")
  donativosAnual           Decimal  @default(0) @map("donativos_anual") @db.Decimal
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("fiscal_perfil")
}

model FiscalDescendiente {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuentaId          String   @map("cuenta_id") @db.Uuid
  nombre            String
  fechaNacimiento   DateTime @map("fecha_nacimiento") @db.Date
  gradoDiscapacidad Int      @default(0) @map("grado_discapacidad")
  computoCompleto   Boolean  @default(true) @map("computo_completo")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cuentaId])
  @@map("fiscal_descendientes")
}

model FiscalNovedad {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anio            Int
  clave           String
  importeAnterior Decimal? @map("importe_anterior") @db.Decimal
  importeNuevo    Decimal? @map("importe_nuevo") @db.Decimal
  beneficia       Boolean  @default(false)
  ambito          String   @default("estatal")
  fuenteUrl       String?  @map("fuente_url")
  detectadoAt     DateTime @default(now()) @map("detectado_at") @db.Timestamptz(6)
  descartado      Boolean  @default(false)

  @@index([beneficia, descartado])
  @@map("fiscal_novedades")
}

// Radar de ayudas/subvenciones (skill fiscal-novedades): convocatorias con plazo.
// tenant NULL = Alberto (se pintan en /finanzas); con valor = radar por cliente.
model FiscalAyuda {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo       String
  organismo    String?
  cuantiaTexto String?   @map("cuantia_texto")
  encaje       String?
  url          String?
  plazoFin     DateTime? @map("plazo_fin") @db.Date
  tenant       String?
  descartado   Boolean   @default(false)
  detectadoAt  DateTime  @default(now()) @map("detectado_at") @db.Timestamptz(6)

  @@index([descartado, plazoFin])
  @@map("fiscal_ayudas")
}

// ── Trading-analista (IBKR, Fase 1 · paper). Tablas nuevas y aisladas; no tocan otras verticales ──
model TradingWatchlist {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simbolo        String
  capa           String // 'A' ancla | 'B' conocido | 'C' cantera
  horizonte      Int       @default(10)
  activo         Boolean   @default(true)
  promocionadoEn DateTime? @map("promocionado_en") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([simbolo])
  @@map("trading_watchlist")
}

model TradingCantera {
  simbolo         String    @id
  semanasSeguidas Int?      @map("semanas_seguidas")
  propuestoAt     DateTime  @default(now()) @map("propuesto_at") @db.Timestamptz(6)
  decision        String? // NULL pendiente | 'alta' | 'rechazada'
  decididoAt      DateTime? @map("decidido_at") @db.Timestamptz(6)
  bajaPropuestaAt DateTime? @map("baja_propuesta_at") @db.Timestamptz(6)
  bajaDecision    String? // NULL pendiente | 'baja' | 'mantener'
  bajaDecididaAt  DateTime? @map("baja_decidida_at") @db.Timestamptz(6)

  @@map("trading_cantera")
}

model TradingTesis {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simbolo       String
  fecha         DateTime               @db.Date
  estrategia    String
  direccion     String
  confianza     Int
  horizonteDias Int                    @map("horizonte_dias")
  precioRef     Float                  @map("precio_ref")
  // PROCEDENCIA de `precioRef`. `'sesion'` = lo mandó la rutina Claude (IBKR); `'stooq'`/`'yahoo'` =
  // fuente propia del servidor. Un cierre de IBKR y uno de Stooq NO son el mismo dato: sin esta columna,
  // cualquier recuperación automática mezclaría fuentes en el track record que decide el capital real.
  precioFuente  String                 @default("sesion") @map("precio_fuente")
  indicadores   Json
  rationale     String
  // `operada` = esta señal fue la GANADORA del torneo de su símbolo Y pasó todas las barreras de riesgo,
  // es decir, el agente la compró de verdad en paper. Se pone en /api/trading/analizar en el momento de
  // abrir. Sirve para que el panel «Ideas de compra del agente» muestre SOLO compras reales, no señales
  // técnicas en bruto (que incluían nombres cuyo torneo ganó bajista o que las barreras vetaron).
  operada       Boolean                @default(false)
  // Si la señal GANADORA alcista NO se compró, aquí queda el porqué («posición ya abierta», «bajo SMA50»,
  // «earnings inminente»…). NULL = no aplica (no ganó el torneo, o sí se compró). Lo pinta /trading.
  motivoBloqueo String?                @map("motivo_bloqueo")
  // `anulado` = esta tesis se construyó sobre un `precioRef` que resultó ser de OTRA empresa (los
  // `get_price_history` paralelos de la sesión se barajaron). No es una tesis mal puntuada: es una
  // señal sobre una compañía distinta con la etiqueta de esta, así que ni se puntúa, ni sirve de
  // referencia de precio, ni sale en el panel. La fila NO se borra — es la cicatriz del incidente.
  // Casos verificados contra IBKR: 17/07, 03/08 y 04/08 de 2026 (ver `lib/trading/precios-guardia.ts`).
  anulado       Boolean                @default(false)
  anuladoMotivo String?                @map("anulado_motivo")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  resultado     TradingTesisResultado?

  // Una señal por símbolo+día+estrategia: el createMany de /analizar lleva skipDuplicates y los
  // reintentos de la pasada no inflan el n del walk-forward (04/08/2026: 288 tesis donde tocaban 52).
  @@unique([simbolo, fecha, estrategia])
  @@index([simbolo, fecha])
  @@map("trading_tesis")
}

model TradingTesisResultado {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tesisId       String       @unique @map("tesis_id") @db.Uuid
  precioDespues Float        @map("precio_despues")
  ventanaDias   Int          @map("ventana_dias")
  retorno       Float
  acierto       Boolean
  puntuadoEn    DateTime     @default(now()) @map("puntuado_en") @db.Timestamptz(6)
  // `anulado` = este resultado se puntuó con un precio que después se demostró falso, así que NO cuenta
  // para las stats de estrategia (el walk-forward que decide si algún día se despliega capital real).
  // La fila NO se borra: se marca. Un resultado anulado es un «esto no lo sabemos», no un dato.
  // `anuladoMotivo` sobrevive a la re-puntuación — es la cicatriz que cuenta qué pasó (caso fundacional:
  // CVX 590,17 del 03/08/2026, ver `lib/trading/precios-guardia.ts`).
  anulado       Boolean      @default(false)
  anuladoMotivo String?      @map("anulado_motivo")
  // Procedencia de `precioDespues` (mismo contrato que `TradingTesis.precioFuente`).
  precioFuente  String       @default("sesion") @map("precio_fuente")
  tesis         TradingTesis @relation(fields: [tesisId], references: [id], onDelete: Cascade)

  @@map("trading_tesis_resultado")
}

model TradingPaperOrden {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simbolo   String
  lado      String // BUY | SELL
  cantidad  Int
  precio    Float
  fecha     DateTime @db.Date
  motivo    String
  // Deslizamiento (proxy): precio del día SIGUIENTE a la señal (lo rellena /puntuar). En real no se
  // ejecuta al cierre de la señal sino al día siguiente — esta columna mide cuánto cuesta esa espera,
  // la única incógnita que el paper no medía. NULL = aún sin dato (no 0).
  precioDiaSiguiente Float? @map("precio_dia_siguiente")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Una orden por símbolo+lado+día: los reintentos de la pasada nocturna no duplican el libro
  // (04/08/2026: 5 BUY idénticas de MSFT). Los endpoints escriben con createMany+skipDuplicates.
  @@unique([simbolo, lado, fecha])
  @@map("trading_paper_orden")
}

// Contador de ejecuciones de la pasada nocturna por día. La idempotencia (únicos de órdenes/tesis)
// hace INVISIBLE un reintento en los datos, así que sin este contador nadie se enteraría de que la
// rutina corrió 5 veces (04/08/2026). /analizar incrementa y avisa por Telegram al llegar a 2.
model TradingPasada {
  fecha    DateTime @id @db.Date
  analizar Int      @default(0)

  @@map("trading_pasadas")
}

model TradingPaperPosicion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simbolo       String   @unique
  cantidad      Int
  precioEntrada Float    @map("precio_entrada")
  stop          Float
  abiertaEn     DateTime @map("abierta_en") @db.Date

  @@map("trading_paper_posicion")
}

model TradingEstrategiaStats {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estrategia    String
  regimen       String
  hitRate       Float    @map("hit_rate")
  retornoMedio  Float    @map("retorno_medio")
  n             Int
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@unique([estrategia, regimen])
  @@map("trading_estrategia_stats")
}

// Snapshot SEMANAL del forward paper (Fase B). Cada fila = medición de UNA cohorte congelada un día.
// Permite dibujar la CURVA del forward (cesta vs SPY) a lo largo del tiempo en vez de recalcular solo el
// número de hoy. Lo escribe el cron `paper-tracker` (idempotente por cohorte+fecha). SOLO lectura/medición.
model TradingPaperTrack {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohorte          String // `version` de la cohorte (ej '2026-07-18.v1')
  fecha            DateTime @db.Date // día de la medición
  dias             Int // días transcurridos desde el `fechaInicio` de la cohorte
  n                Int // símbolos con datos suficientes
  retornoCesta     Float    @map("retorno_cesta") // media equiponderada
  retornoMediana   Float?   @map("retorno_mediana") // mediana (métrica robusta de decisión)
  retornoBench     Float    @map("retorno_bench") // benchmark (SPY)
  alpha            Float // media − bench
  alphaMediana     Float?   @map("alpha_mediana") // mediana − bench
  baten            Int // nº de símbolos que batieron individualmente al bench
  // Riesgo (idea 3) — batir con más riesgo no es batir.
  maxDrawdown      Float?   @map("max_drawdown") // caída máxima pico→valle de la cesta (≤ 0)
  maxDrawdownBench Float?   @map("max_drawdown_bench") // ídem del benchmark
  volAnual         Float?   @map("vol_anual") // volatilidad anualizada de la cesta
  trackingError    Float?   @map("tracking_error") // riesgo activo vs el índice (anualizado)
  // Atribución (idea 4) — cesta gurús-solo (2º benchmark) para aislar el aporte del filtro de calidad.
  retornoBase      Float?   @map("retorno_base") // media de la cesta gurús-solo
  medianaBase      Float?   @map("mediana_base") // mediana de la cesta gurús-solo
  nBase            Int?     @map("n_base") // símbolos con datos de la cesta base
  benchmark        String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([cohorte, fecha])
  @@index([cohorte])
  @@map("trading_paper_track")
}

// Radar del universo EEUU (Fase 1). Caché incremental de fundamentales+precio por símbolo; la
// refresca el cron `trading-universo` por lotes (los más rancios primero). SOLO lectura/medición.
model TradingUniverso {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simbolo       String   @unique
  cik           String?
  nombre        String?
  piotroski     Int?
  roic          Float?
  earningsYield Float?   @map("earnings_yield") // EBIT/EV (EV = mktCap + deudaLp − caja)
  fcfYield      Float?   @map("fcf_yield") // (CFO − capex)/mktCap — H4 pre-registrada, cableada 19/07
  momentum      Float? // 12-1 desde el histórico cacheado
  precio        Float?
  mktCap        Float?   @map("mkt_cap")
  datos         Json? // FundamentalesEmpresa crudo (debug/reuso)
  fuenteFy      Int?     @map("fuente_fy") // ejercicio fiscal del dato
  error         String? // último fallo de fetch (salud de datos)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@index([actualizadoEn])
  @@map("trading_universo")
}

// Snapshot SEMANAL del ranking del radar (una fila por lunes). `entries` = top-N con nombre/score/
// etiqueta/badges; trackRecord y salud van dentro para que la UI pinte sin recalcular. Idempotente.
model TradingRanking {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha         DateTime @unique @db.Date
  entries       Json
  cohetes       Json? // 🚀 satélite caza-cohetes (lotería, aparte del núcleo; ver radar.ts)
  trackRecord   Json?    @map("track_record")
  salud         Json?
  universoTotal Int      @map("universo_total")
  conDatos      Int      @map("con_datos")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("trading_ranking")
}

// 🚀 Cartera cohetes (paper): libro de rebalanceos inmutable (ver lib/trading/cartera-cohetes-io.ts).
model TradingCohetesRebalanceo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha       DateTime @unique @db.Date
  capitalEur  Float    @map("capital_eur")
  cesta       Json
  spyPrecio   Float?   @map("spy_precio")
  spyUnidades Float?   @map("spy_unidades")
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("trading_cohetes_rebalanceo")
}

// 🚀 Cartera cohetes (paper): curva diaria (valor + SPY + P&L + sub-cesta IPO).
model TradingCohetesTrack {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha       DateTime @unique @db.Date
  valorEur    Float    @map("valor_eur")
  spyEur      Float?   @map("spy_eur")
  plPct       Float?   @map("pl_pct")
  alphaPct    Float?   @map("alpha_pct")
  ipoValorEur Float?   @map("ipo_valor_eur")
  ipoPlPct    Float?   @map("ipo_pl_pct")
  nIpo        Int?     @map("n_ipo")
  detalle     Json?
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("trading_cohetes_track")
}

// 🔭 RETROVISOR del radar (backtest punto-en-el-tiempo, SOLO paper): una fila por símbolo con
// `datos.porFecha` = factores conocidos el día 1 de cada mes + retornos forward 28/56/91d. Fila
// especial `_GURUS_` = convicciones Dataroma × factores actuales. INDICATIVO: no toca las tablas
// honestas del forward (trading_ranking / trading_paper_track). Rellena /api/cron/trading-backtest.
model TradingBacktest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simbolo       String   @unique
  cik           String?
  nombre        String?
  datos         Json?
  error         String?
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@index([actualizadoEn])
  @@map("trading_backtest")
}

// Saldo del bróker (Interactive Brokers) para la vista 💶 Dinero de /banca. Lo refresca la pasada
// diaria del agente `trading-analista` por POST /api/trading/saldo (la app no habla con IBKR).
model BrokerSaldo {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuentaId      String   @map("cuenta_id") @db.Uuid
  broker        String
  saldo         Decimal  @db.Decimal(14, 2)
  divisa        String   @default("EUR")
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@unique([cuentaId, broker])
  @@index([cuentaId])
  @@map("broker_saldos")
}

// 💼 Cartera REAL del bróker (posición a posición) para el panel /trading. La refresca la pasada
// diaria del agente `trading-analista` por POST /api/trading/cartera (la app no habla con IBKR).
// Importes en la DIVISA de cada posición (no siempre EUR); NULL = IBKR no dio el dato, jamás 0.
model TradingCarteraReal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuentaId       String   @map("cuenta_id") @db.Uuid
  broker         String
  simbolo        String
  descripcion    String?
  cantidad       Decimal  @db.Decimal(18, 4)
  precioMedio    Decimal? @map("precio_medio") @db.Decimal(18, 6)
  precioActual   Decimal? @map("precio_actual") @db.Decimal(18, 6)
  valorMercado   Decimal? @map("valor_mercado") @db.Decimal(16, 2)
  pnlNoRealizado Decimal? @map("pnl_no_realizado") @db.Decimal(16, 2)
  pnlDiario      Decimal? @map("pnl_diario") @db.Decimal(16, 2)
  divisa         String   @default("EUR")
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@unique([cuentaId, broker, simbolo])
  @@index([cuentaId])
  @@map("trading_cartera_real")
}

// Marca de sincronización de la cartera real: sin fila = «IBKR sin leer todavía»; fila con
// num_posiciones=0 = «leída y vacía». Distingue el «no lo sé» del «no hay» (regla del repo).
model TradingCarteraRealSync {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuentaId      String   @map("cuenta_id") @db.Uuid
  broker        String
  numPosiciones Int      @default(0) @map("num_posiciones")
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@unique([cuentaId, broker])
  @@map("trading_cartera_real_sync")
}

// Serie histórica de la cartera real: un punto por día y DIVISA (nunca se suman divisas). La foto
// de `trading_cartera_real` se reemplaza en cada pasada, así que sin esta tabla no hay pasado que
// dibujar. `completo=false` = total parcial (a alguna posición le faltaba valor o coste).
model TradingCarteraRealTrack {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuentaId      String   @map("cuenta_id") @db.Uuid
  broker        String
  fecha         DateTime @db.Date
  divisa        String
  invertido     Decimal? @db.Decimal(16, 2)
  valor         Decimal? @db.Decimal(16, 2)
  pnl           Decimal? @db.Decimal(16, 2)
  completo      Boolean  @default(true)
  numPosiciones Int      @default(0) @map("num_posiciones")
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@unique([cuentaId, broker, fecha, divisa])
  @@index([cuentaId, fecha(sort: Desc)])
  @@map("trading_cartera_real_track")
}
