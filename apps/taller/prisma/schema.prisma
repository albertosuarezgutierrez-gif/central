}

// ─── F1: clientes, vehículos, recepción, OT, partes, presupuestos, consentimientos ───────────────────────────
// Espejo exacto de 0001_schema_taller.sql. Columnas GENERADAS (matricula_normalizada, partes_horas.minutos) no se escriben.

model Cliente {
