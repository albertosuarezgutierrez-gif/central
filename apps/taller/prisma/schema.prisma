// Schema `taller` (F1). La VERDAD del esquema es prisma/sql/*.sql (se aplica a mano, nunca `prisma migrate`/`db push`).
// Aquí solo se modelan las tablas que la app ya usa (login PIN + Ajustes); el resto entra con su fase.
// Sin relaciones Prisma a propósito: las FK reales son COMPUESTAS (taller_id, id) y viven en SQL.
// 🚨 Toda consulta pasa por `conTaller()` (lib/rls.ts): sin ajuste de sesión, RLS devuelve cero filas.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["taller"]
}

model Taller {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razonSocial         String   @map("razon_social")
  nombreComercial     String   @map("nombre_comercial")
  nif                 String?
  cp                  String?
  provincia           String?
  municipio           String?
  via                 String?
  numero              String?
  referenciaCatastral String?  @map("referencia_catastral")
  marcaCodigo         String?  @map("marca_codigo")
  /// Código corto de acceso (migración 0006): el dispositivo lo recuerda y resuelve el taller en el login. Único.
  codigoAcceso        String?  @unique @map("codigo_acceso")
  /// Empresa de este taller en rrhh (migración 0005). El taller solo ENVÍA fichajes; no lee rrhh.
  rrhhEmpresaId       String?  @map("rrhh_empresa_id") @db.Uuid
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("talleres")
  @@schema("taller")
}

model Configuracion {
  tallerId                       String   @id @map("taller_id") @db.Uuid
  precioHoraCent                 BigInt   @map("precio_hora_cent")
  validezPresupuestoDias         Int      @map("validez_presupuesto_dias")
  itvAntelacionDias              Int      @map("itv_antelacion_dias")
  revisionFechaAntelacionDias    Int      @map("revision_fecha_antelacion_dias")
  revisionKmAntelacion           Int      @map("revision_km_antelacion")
  seguroAntelacionDias           Int      @map("seguro_antelacion_dias")
  recordatorioCitaHoras          Int      @map("recordatorio_cita_horas")
  citaDuracionHuecoMinutos       Int      @map("cita_duracion_hueco_minutos")
  citaPuestos                    Int      @map("cita_puestos")
  textoPieResguardo              String   @default("") @map("texto_pie_resguardo")
  textoPieFactura                String   @default("") @map("texto_pie_factura")
  textoCondicionesPresupuesto    String   @default("") @map("texto_condiciones_presupuesto")
  textoFirmaCorreo               String   @default("") @map("texto_firma_correo")
  textoConsentimientoComercial   String   @map("texto_consentimiento_comercial")
  versionConsentimientoComercial String   @map("version_consentimiento_comercial")
  loginMaxFallosTaller           Int      @default(30) @map("login_max_fallos_taller")
  loginVentanaMinutos            Int      @default(15) @map("login_ventana_minutos")
  loginBloqueoTallerMinutos      Int      @default(15) @map("login_bloqueo_taller_minutos")
  loginMaxFallosUsuario          Int      @default(5) @map("login_max_fallos_usuario")
  loginBloqueoUsuarioMinutos     Int      @default(300) @map("login_bloqueo_usuario_minutos")
  loginSesionMinutos             Int      @default(300) @map("login_sesion_minutos")
  loginInactividadMinutos        Int      @default(30) @map("login_inactividad_minutos")
  marcaLogoRuta                  String?  @map("marca_logo_ruta")
  marcaColorPrimario             String?  @map("marca_color_primario")
  marcaColorSecundario           String?  @map("marca_color_secundario")
  agendaZonaHoraria              String   @default("Europe/Madrid") @map("agenda_zona_horaria")
  agendaMaxCochesFranja          Int      @default(2) @map("agenda_max_coches_franja")
  agendaOcupablePb               Int      @default(8500) @map("agenda_ocupable_pb")
  agendaMargenMinutos            Int      @default(15) @map("agenda_margen_minutos")
  agendaAntelacionMinHoras       Int      @default(12) @map("agenda_antelacion_min_horas")
  agendaAntelacionMaxDias        Int      @default(60) @map("agenda_antelacion_max_dias")
  agendaConfirmacion             String   @default("manual") @map("agenda_confirmacion")
  agendaDiagnosticoMinutos       Int      @default(60) @map("agenda_diagnostico_minutos")
  agendaInvitacionCaducaDias     Int      @default(14) @map("agenda_invitacion_caduca_dias")
  /// 0008: días que se conservan las fotos de daños y de trabajo desde la entrega (mínimo 90, alta 180).
  fotosRetencionDias             Int      @default(180) @map("fotos_retencion_dias")
  retiradaFirmaObligatoria       Boolean  @default(true) @map("retirada_firma_obligatoria")
  retiradaTextoConformidad       String   @map("retirada_texto_conformidad")
  retiradaVersionTexto           String   @default("retirada-borrador-1") @map("retirada_version_texto")
  creadoEn                       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn                  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("configuracion")
  @@schema("taller")
}

