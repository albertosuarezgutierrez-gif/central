  precioHoraCent     BigInt?   @map("precio_hora_cent")
  baseCent           BigInt    @default(0) @map("base_cent")
  cuotaIvaCent       BigInt    @default(0) @map("cuota_iva_cent")
  totalCent          BigInt    @default(0) @map("total_cent")
  pdfRuta            String?   @map("pdf_ruta")
  tokenHash          String?   @unique @map("token_hash")
  caducaEn           DateTime? @map("caduca_en") @db.Timestamptz(6)
  aceptadoEn         DateTime? @map("aceptado_en") @db.Timestamptz(6)
  aceptadoIp         String?   @map("aceptado_ip") @db.Inet
