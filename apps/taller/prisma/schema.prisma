  actualizadoEn    DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("presupuesto_lineas")
  @@schema("taller")
}

/// Solo-añadir (trigger en BD; el rol solo puede UPDATE de retirado_en/motivo_retirada).
model Consentimiento {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tallerId       String    @map("taller_id") @db.Uuid
  clienteId      String    @map("cliente_id") @db.Uuid
  finalidad      String
  otorgado       Boolean
  versionTexto   String    @map("version_texto")
  textoMostrado  String    @map("texto_mostrado")
  canal          String
  firmaRuta      String?   @map("firma_ruta")
  ip             String?   @db.Inet
  userAgent      String?   @map("user_agent")
  otorgadoEn     DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(6)
  retiradoEn     DateTime? @map("retirado_en") @db.Timestamptz(6)
  motivoRetirada String?   @map("motivo_retirada")
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("consentimientos")
  @@schema("taller")
}

// ─── 0004: mecánico en su OT (notas, fotos, propuestas de ampliación) ────────────────────────────────────────
model OtNota {
