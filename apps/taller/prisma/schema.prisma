  tallerId            String   @map("taller_id") @db.Uuid
  nombre              String
  nif                 String?
  movil               String?
  correo              String?
  cp                  String?
  provincia           String?
  municipio           String?
  via                 String?
  numero              String?
  referenciaCatastral String?  @map("referencia_catastral")
