// ─── SEGUNDA BASE DE DATOS DE LA APP: la cartera REAL (proyecto ASEGURA) ────
// Cliente generado aparte del principal (schema.prisma sigue siendo la BD
// compartida de central, donde vive la auth `public.cuentas`). Este apunta al
// proyecto Supabase ASEGURA-prod-eu vía ASEGURA_DATABASE_URL.
// Generar: `pnpm run prisma:generate` (los DOS clientes; CI usa ese script).
// Sin ASEGURA_DATABASE_URL la app no arranca esta parte: el dashboard lo dice
// como «conexión pendiente», nunca como «no hay cartera».

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/asegura-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ASEGURA_DATABASE_URL")
}

enum TipoSeguro {
  auto
  moto
  hogar
  vida
  salud
  decesos
  responsabilidad_civil
  comercio
  comunidades
  otros

  @@map("tipo_seguro")
}

enum EstadoPoliza {
  activa
  vencida
  cancelada
  en_renovacion
  en_vigor
  fin_riesgo
  recibo_devuelto
  cambio_clave
  anula_al_vencimiento
  competencia

  @@map("estado_poliza")
}

enum PolizaOrigen {
  gestionada_correduria
  declarada_usuario
  /// La emitimos nosotros por Codeoscopic y CIMA aún no la ha traído (spec 2026-09-02, D2).
  emitida_codeoscopic

  @@map("poliza_origen")
}

enum Fraccionamiento {
  anual
  semestral
  trimestral
  mensual

  @@map("fraccionamiento")
}

enum CanalRecordatorio {
  email
  whatsapp
  ambos

  @@map("canal_recordatorio")
}

enum PlanSuscripcion {
  trial
  basico
  profesional
  enterprise

  @@map("plan_suscripcion")
}

enum SegmentoCliente {
  cliente
  ex_cliente
  prospecto

  @@map("segmento_cliente")
}

enum TipoCliente {
  cliente
  lead
  beneficiario

  @@map("tipo_cliente")
}

enum LeadEstado {
  nuevo
  contactado
  cualificado
  propuesta
  ganado
  perdido

  @@map("lead_estado")
}

enum TipoPersona {
  fisica
  juridica

  @@map("tipo_persona")
}

enum FuenteOrigen {
  venta_directa
  tarifas_blancas
  ahorro_seguro
  recomendacion
  renovacion
  otros
  /// Canales de lead (02/09/2026): formulario público, portal del cliente, WhatsApp (cuando haya WABA).
  web
  portal
  whatsapp

  @@map("fuente_origen")
}

enum IntervinienteRol {
  propietario
  conductor_habitual
  conductor_ocasional
  contacto
  beneficiario
  asegurado

  @@map("interviniente_rol")
}

enum IntervinienteOrigen {
  manual
  cima

  @@map("interviniente_origen")
}

enum ReciboEstado {
  cobrado
  pendiente
  devuelto
  anulado
  emitido

  @@map("recibo_estado")
}

enum ReciboOrigen {
  manual
  cima

  @@map("recibo_origen")
}

enum EstadoSiniestro {
  abierto
  en_tramitacion
  cerrado
  rechazado

  @@map("estado_siniestro")
}

enum SiniestroOrigen {
  gestionado_correduria
  cima

  @@map("siniestro_origen")
}

enum SiniestroGravedad {
  leve
  moderado
  grave
  muy_grave

  @@map("siniestro_gravedad")
}

model Correduria {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre              String             @db.VarChar(255)
  cif                 String             @unique @db.VarChar(20)
  email               String             @db.VarChar(255)
  telefono            String?            @db.VarChar(20)
  direccion           String?
  codigoPostal        String?            @map("codigo_postal") @db.VarChar(10)
  ciudad              String?            @db.VarChar(100)
  provincia           String?            @db.VarChar(100)
  logoUrl             String?            @map("logo_url")
  web                 String?            @db.VarChar(255)
  // Credenciales de WhatsApp Business DENTRO de la tabla (hoy NULL): campo de
  // secreto — nunca a un export ni a un log.
  waPhoneNumberId     String?            @map("wa_phone_number_id") @db.VarChar(100)
  waBusinessAccountId String?            @map("wa_business_account_id") @db.VarChar(100)
  waAccessToken       String?            @map("wa_access_token")
  plan                PlanSuscripcion    @default(trial)
  planExpiresAt       DateTime?          @map("plan_expires_at") @db.Timestamp(6)
  maxPolizas          Int                @default(500) @map("max_polizas")
  recordatoriosDias   Json?              @map("recordatorios_dias")
  recordatoriosCanal  CanalRecordatorio? @map("recordatorios_canal")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamp(6)

  clientes   Cliente[]
  polizas    Poliza[]
  siniestros Siniestro[]

  @@map("corredurias")
}

model Cliente {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId        String             @map("correduria_id") @db.Uuid
  usuarioId           String?            @map("usuario_id") @db.Uuid
  nombre              String             @db.VarChar(255)
  apellidos           String             @db.VarChar(255)
  dni                 String? // cifrado
  telefono            String? // cifrado
  email               String? // cifrado
  fechaNacimiento     String?            @map("fecha_nacimiento") // cifrado (fue date)
  direccion           String? // cifrado
  codigoPostal        String?            @map("codigo_postal") @db.VarChar(10)
  ciudad              String?            @db.VarChar(100)
  provincia           String?            @db.VarChar(100)
  waOptIn             Boolean            @default(false) @map("wa_opt_in")
  waPhoneNumber       String?            @map("wa_phone_number") @db.VarChar(20)
  canalPreferido      CanalRecordatorio? @default(email) @map("canal_preferido")
  notas               String?
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamp(6)
  importRef           String?            @map("import_ref") @db.VarChar(100)
  waOptOutAt          DateTime?          @map("wa_opt_out_at") @db.Timestamp(6)
  waOptOutSource      String?            @map("wa_opt_out_source") @db.VarChar(30)
  emailOptOutAt       DateTime?          @map("email_opt_out_at") @db.Timestamp(6)
  emailOptOutSource   String?            @map("email_opt_out_source") @db.VarChar(30)
  emailLookupHash     String?            @map("email_lookup_hash")
  telefonoLookupHash  String?            @map("telefono_lookup_hash")
  activo              Boolean            @default(true)
  segmento            SegmentoCliente    @default(prospecto)
  tipo                TipoCliente        @default(cliente)
  dniLookupHash       String?            @map("dni_lookup_hash")
  tipoPersona         TipoPersona?       @map("tipo_persona")
  leadEstado          LeadEstado         @default(nuevo) @map("lead_estado")
  cohortInvitedAt     DateTime?          @map("cohort_invited_at") @db.Timestamp(6)
  comercialId         String?            @map("comercial_id") @db.Uuid
  fuente              FuenteOrigen?
  estadoCivil         String?            @map("estado_civil") @db.VarChar(40)
  ocupacion           String?            @db.VarChar(120)
  sector              String?            @db.VarChar(120)
  cuentaBancaria      String?            @map("cuenta_bancaria") // cifrado, sin hash (no se busca)
  saludo              String?            @db.VarChar(10)
  direccionFiscal     String?            @map("direccion_fiscal") // cifrado
  cpFiscal            String?            @map("cp_fiscal") @db.VarChar(10)
  ciudadFiscal        String?            @map("ciudad_fiscal") @db.VarChar(100)
  provinciaFiscal     String?            @map("provincia_fiscal") @db.VarChar(100)
  mergedIntoClienteId String?            @map("merged_into_cliente_id") @db.Uuid // lápida de fusión

  correduria     Correduria            @relation(fields: [correduriaId], references: [id])
  mergedInto     Cliente?              @relation("FusionCliente", fields: [mergedIntoClienteId], references: [id])
  absorbidos     Cliente[]             @relation("FusionCliente")
  telefonos      ClienteTelefono[]
  emails         ClienteEmail[]
  relacionesA    ClienteRelacion[]     @relation("RelacionA")
  relacionesB    ClienteRelacion[]     @relation("RelacionB")
  polizas        Poliza[]
  siniestros     Siniestro[]
  intervenciones PolizaInterviniente[]

  @@map("clientes")
}

model ClienteTelefono {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId          String   @map("cliente_id") @db.Uuid
  correduriaId       String   @map("correduria_id") @db.Uuid
  telefono           String // cifrado
  telefonoLookupHash String?  @map("telefono_lookup_hash")
  etiqueta           String?  @db.VarChar(30)
  esPrincipal        Boolean  @default(false) @map("es_principal")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("cliente_telefonos")
}

/// Vínculos cliente↔cliente del CRM (dos filas por vínculo, una por sentido).
/// `tipo_relacion` = B respecto de A; `puede_ver_polizas` = A autoriza a B a ver
/// las pólizas de A. Reglas en `@central/module-seguros` (relaciones.ts).
model ClienteRelacion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId    String   @map("correduria_id") @db.Uuid
  clienteAId      String   @map("cliente_a_id") @db.Uuid
  clienteBId      String   @map("cliente_b_id") @db.Uuid
  tipoRelacion    String   @map("tipo_relacion") @db.VarChar(60)
  puedeVerPolizas Boolean  @default(false) @map("puede_ver_polizas")
  observaciones   String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clienteA Cliente @relation("RelacionA", fields: [clienteAId], references: [id], onDelete: Cascade)
  clienteB Cliente @relation("RelacionB", fields: [clienteBId], references: [id], onDelete: Cascade)

  @@unique([clienteAId, clienteBId, tipoRelacion], map: "uq_cliente_relaciones_a_b_tipo")
  @@map("cliente_relaciones")
}

model ClienteEmail {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId       String   @map("cliente_id") @db.Uuid
  correduriaId    String   @map("correduria_id") @db.Uuid
  email           String // cifrado
  emailLookupHash String?  @map("email_lookup_hash")
  etiqueta        String?  @db.VarChar(30)
  esPrincipal     Boolean  @default(false) @map("es_principal")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("cliente_emails")
}

model Poliza {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId            String           @map("correduria_id") @db.Uuid
  clienteId               String           @map("cliente_id") @db.Uuid
  tipo                    TipoSeguro
  aseguradora             String           @db.VarChar(255)
  numeroPoliza            String?          @map("numero_poliza") @db.VarChar(100)
  // fecha_inicio y fecha_vencimiento son NULLABLE (1.194 filas legacy a NULL,
  // medido 31/08). NULL = «pendiente», nunca «no vence».
  fechaInicio             DateTime?        @map("fecha_inicio") @db.Date
  fechaVencimiento        DateTime?        @map("fecha_vencimiento") @db.Date
  primaAnual              Decimal?         @map("prima_anual") @db.Decimal(10, 2)
  primaMensual            Decimal?         @map("prima_mensual") @db.Decimal(10, 2)
  estado                  EstadoPoliza     @default(activa)
  datosEspecificos        Json?            @map("datos_especificos") // contiene direccion CIFRADA
  coberturas              Json?
  documentoUrl            String?          @map("documento_url")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  importRef               String?          @map("import_ref") @db.VarChar(100)
  origen                  PolizaOrigen     @default(gestionada_correduria)
  companiaDeclarada       String?          @map("compania_declarada") @db.VarChar(255)
  verificadoPorCorreduria Boolean          @default(false) @map("verificado_por_correduria")
  idPolizaEntidad         String?          @map("id_poliza_entidad") @db.VarChar(50)
  codigoEntidadDgs        String?          @map("codigo_entidad_dgs") @db.VarChar(16)
  ramoDgs                 String?          @map("ramo_dgs") @db.VarChar(8)
  situacion               String?          @db.VarChar(4)
  fechaEfectoInicial      DateTime?        @map("fecha_efecto_inicial") @db.Date
  eiacXmlHash             String?          @map("eiac_xml_hash") @db.VarChar(64)
  primaBruta              Decimal?         @map("prima_bruta") @db.Decimal(10, 2)
  fraccionamiento         Fraccionamiento?
  cuentaBancaria          String?          @map("cuenta_bancaria") // cifrado
  comercialId             String?          @map("comercial_id") @db.Uuid
  polizaPadreId           String?          @map("poliza_padre_id") @db.Uuid // cadena de renovaciones
  auditarSeguimiento      Boolean          @default(false) @map("auditar_seguimiento")
  oportunidadOrigenId     String?          @map("oportunidad_origen_id") @db.Uuid
  polizaCompetencia       Json?            @map("poliza_competencia")
  polizaSustituida        Json?            @map("poliza_sustituida")
  mergedIntoPolizaId      String?          @map("merged_into_poliza_id") @db.Uuid // lápida de fusión

  correduria     Correduria            @relation(fields: [correduriaId], references: [id])
  cliente        Cliente               @relation(fields: [clienteId], references: [id])
  polizaPadre    Poliza?               @relation("Renovacion", fields: [polizaPadreId], references: [id])
  renovaciones   Poliza[]              @relation("Renovacion")
  mergedInto     Poliza?               @relation("FusionPoliza", fields: [mergedIntoPolizaId], references: [id])
  absorbidas     Poliza[]              @relation("FusionPoliza")
  coberturasRel  PolizaCobertura[]
  recibos        PolizaRecibo[]
  intervinientes PolizaInterviniente[]
  siniestros     Siniestro[]

  @@map("polizas")
}

model PolizaCobertura {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId        String    @map("correduria_id") @db.Uuid
  polizaId            String    @map("poliza_id") @db.Uuid
  numeroOrden         Int?      @map("numero_orden")
  codigo              String?
  descripcion         String?
  capitalAsegurado    String?   @map("capital_asegurado") // dato de contrato, texto EIAC
  descripcionCapital  String?   @map("descripcion_capital")
  franquicia          String?
  fechaInicio         DateTime? @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin            DateTime? @map("fecha_fin") @db.Timestamptz(6)
  modalidadValoracion String?   @map("modalidad_valoracion")
  datosExtra          Json?     @map("datos_extra")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  poliza Poliza @relation(fields: [polizaId], references: [id], onDelete: Cascade)

  @@map("poliza_coberturas")
}

model PolizaRecibo {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId       String        @map("correduria_id") @db.Uuid
  polizaId           String        @map("poliza_id") @db.Uuid
  idRecibo           String?       @map("id_recibo")
  codigoEntidadDgs   String?       @map("codigo_entidad_dgs")
  situacion          ReciboEstado?
  claseRecibo        String?       @map("clase_recibo")
  fechaEfectoInicial DateTime?     @map("fecha_efecto_inicial") @db.Timestamptz(6)
  fechaEfectoActual  DateTime?     @map("fecha_efecto_actual") @db.Timestamptz(6)
  fechaVencimiento   DateTime?     @map("fecha_vencimiento") @db.Timestamptz(6)
  fechaEmision       DateTime?     @map("fecha_emision") @db.Timestamptz(6)
  fechaSituacion     DateTime?     @map("fecha_situacion") @db.Timestamptz(6)
  // Importes en TEXT (tal cual llegan del EIAC), no numeric: parsear al leer.
  primaTotal         String?       @map("prima_total")
  primaNeta          String?       @map("prima_neta")
  formaPago          String?       @map("forma_pago")
  iban               String? // cifrado
  comisionBruta      String?       @map("comision_bruta")
  comisionLiquida    String?       @map("comision_liquida")
  datosExtra         Json?         @map("datos_extra")
  eiacXmlHash        String?       @map("eiac_xml_hash")
  origen             ReciboOrigen  @default(cima)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  poliza Poliza @relation(fields: [polizaId], references: [id], onDelete: Cascade)

  @@map("poliza_recibos")
}

model PolizaInterviniente {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  polizaId         String              @map("poliza_id") @db.Uuid
  correduriaId     String              @map("correduria_id") @db.Uuid
  rol              IntervinienteRol
  clienteId        String?             @map("cliente_id") @db.Uuid
  tipoRelacion     String?             @map("tipo_relacion") @db.VarChar(60)
  nif              String? // cifrado
  nifLookupHash    String?             @map("nif_lookup_hash")
  nombre           String? // cifrado
  apellidos        String? // cifrado
  fechaNacimiento  String?             @map("fecha_nacimiento") // cifrado
  telefono         String? // cifrado
  email            String? // cifrado
  fechaCarnet      String?             @map("fecha_carnet") // cifrado
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  respondeA        String?             @map("responde_a") @db.VarChar(120)
  antiguedadCarnet Int?                @map("antiguedad_carnet")
  origen           IntervinienteOrigen @default(manual)

  poliza  Poliza   @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@map("poliza_intervinientes")
}

model Siniestro {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId         String             @map("correduria_id") @db.Uuid
  clienteId            String             @map("cliente_id") @db.Uuid
  polizaId             String             @map("poliza_id") @db.Uuid
  comercialId          String?            @map("comercial_id") @db.Uuid
  estado               EstadoSiniestro    @default(abierto)
  tipo                 String?            @db.VarChar(60)
  referencia           String?            @db.VarChar(100)
  fechaHora            DateTime?          @map("fecha_hora") @db.Timestamptz(6)
  lugarDireccion       String?            @map("lugar_direccion") // cifrado
  lugarCp              String?            @map("lugar_cp") @db.VarChar(10)
  lugarCiudad          String?            @map("lugar_ciudad") @db.VarChar(100)
  lugarProvincia       String?            @map("lugar_provincia") @db.VarChar(100)
  seConsideraCulpable  Boolean?           @map("se_considera_culpable")
  comentario           String? // campo libre operativo, NO cifrado a propósito
  tramitadorNombre     String?            @map("tramitador_nombre") @db.VarChar(255)
  tramitadorTelefono   String?            @map("tramitador_telefono") @db.VarChar(30)
  tramitadorEmail      String?            @map("tramitador_email") @db.VarChar(255)
  peritoNombre         String?            @map("perito_nombre") @db.VarChar(255)
  peritoTelefono       String?            @map("perito_telefono") @db.VarChar(30)
  peritoEmail          String?            @map("perito_email") @db.VarChar(255)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  origen               SiniestroOrigen    @default(gestionado_correduria)
  eiacXmlHash          String?            @map("eiac_xml_hash") @db.VarChar(64)
  idSiniestroEntidad   String?            @map("id_siniestro_entidad") @db.VarChar(50)
  codigoEntidadDgs     String?            @map("codigo_entidad_dgs") @db.VarChar(16)
  gravedad             SiniestroGravedad?
  reservaImporte       Decimal?           @map("reserva_importe") @db.Decimal(12, 2)
  indemnizacionImporte Decimal?           @map("indemnizacion_importe") @db.Decimal(12, 2)

  correduria Correduria @relation(fields: [correduriaId], references: [id])
  cliente    Cliente    @relation(fields: [clienteId], references: [id])
  poliza     Poliza     @relation(fields: [polizaId], references: [id])

  @@map("siniestros")
}

/// Cuenta de efectivo EIAC: el extracto de liquidación de una compañía para un
/// periodo. Importes en TEXT (tal cual llegan del EIAC), como en PolizaRecibo:
/// parsear al leer y NUNCA colapsar un ilegible a 0.
model CuentaEfectivo {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId        String    @map("correduria_id") @db.Uuid
  codigoEntidadDgs    String?   @map("codigo_entidad_dgs")
  periodoInicio       DateTime? @map("periodo_inicio") @db.Timestamptz(6)
  periodoFin          DateTime? @map("periodo_fin") @db.Timestamptz(6)
  saldoInicial        String?   @map("saldo_inicial")
  saldoFinal          String?   @map("saldo_final")
  recibosCobrados     String?   @map("recibos_cobrados")
  comisionesRecibos   String?   @map("comisiones_recibos")
  retencionComisiones String?   @map("retencion_comisiones")
  siniestrosPagados   String?   @map("siniestros_pagados")
  otrosConceptos      String?   @map("otros_conceptos")
  retencionOtros      String?   @map("retencion_otros")
  remesas             String?
  eiacXmlHash         String?   @map("eiac_xml_hash")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correduriaId, periodoInicio])
  @@map("cuenta_efectivo")
}

/// Remesa concreta de una compañía. `fechaPago` NULL = deuda reconocida y NO
/// ingresada, que es distinto de «no hay liquidación».
model Liquidacion {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId         String    @map("correduria_id") @db.Uuid
  cuentaEfectivoId     String?   @map("cuenta_efectivo_id") @db.Uuid
  idLiquidacionEntidad String?   @map("id_liquidacion_entidad")
  codigoEntidadDgs     String?   @map("codigo_entidad_dgs")
  fechaLiquidacion     DateTime? @map("fecha_liquidacion") @db.Timestamptz(6)
  fechaPago            DateTime? @map("fecha_pago") @db.Timestamptz(6)
  importeRemesa        String?   @map("importe_remesa")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correduriaId, fechaLiquidacion])
  @@map("liquidaciones")
}

// ─── Documentos de la correduría (tabla PROPIA, 02/09/2026) ──────────────────
// Una tabla para cliente | póliza | siniestro, con estado «pedido» (sin fichero)
// / «recibido» / «revisado». El fichero va en `contenido` (bytea ≤ 10 MB). SQL en
// prisma/sql/2026-09-02_seguros_documentos.sql. Sin relaciones a propósito: se
// consulta siempre con `correduriaId` explícito y se valida el destino antes de
// escribir (lib/cartera-documentos.ts).
// ─── Compañías por código DGS (02/09/2026) ────────────────────────────────────
// El puente entre Codeoscopic (habla en código DGS) y CIMA (habla en NOMBRE exacto).
// `nombreCima` NULL = no se ha visto ninguna póliza de CIMA de esa compañía: no se
// inventa. SQL en prisma/sql/2026-09-02_seguros_companias_dgs.sql.
model CompaniaDgs {
  codigoDgs   String   @id @map("codigo_dgs") @db.VarChar(16)
  nombreComun String   @map("nombre_comun") @db.VarChar(255)
  nombreCima  String?  @map("nombre_cima") @db.VarChar(255)
  enCima      Boolean  @default(false) @map("en_cima")
  activa      Boolean  @default(true)
  notas       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("companias_dgs")
}

model Documento {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId      String    @map("correduria_id") @db.Uuid
  clienteId         String?   @map("cliente_id") @db.Uuid
  polizaId          String?   @map("poliza_id") @db.Uuid
  siniestroId       String?   @map("siniestro_id") @db.Uuid
  /// El parte de siniestro del PORTAL del que cuelga (03/09/2026). Lo escribe
  /// `apps/asegura-portal` cuando el cliente adjunta fotos o el PDF del
  /// amistoso; aquí es solo lectura, y es lo que hace que esos ficheros
  /// aparezcan en la bandeja de partes de Alberto y no en un cajón aparte.
  portalParteId     String?   @map("portal_parte_id") @db.Uuid
  tipo              String    @default("otro")
  estado            String    @default("recibido")
  nombreFichero     String?   @map("nombre_fichero")
  mimeType          String?   @map("mime_type")
  sizeBytes         Int?      @map("size_bytes")
  sha256            String?
  contenido         Bytes?
  notas             String?
  subidoPor         String    @default("corredor") @map("subido_por")
  visiblePorCliente Boolean   @default(false) @map("visible_por_cliente")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revisadoAt        DateTime? @map("revisado_at") @db.Timestamptz(6)
  revisadoPor       String?   @map("revisado_por")

  @@index([correduriaId, clienteId])
  @@index([correduriaId, polizaId])
  @@index([portalParteId])
  @@map("documentos")
}

// ─── El calendario del PORTAL, visto desde el panel del corredor ────────────
// Espejo PARCIAL de `seguros.portal_obligacion` (DDL y comentario largo en
// `apps/asegura-portal/prisma/sql/2026-09-03_portal_obligacion.sql`).
//
// 🚨 Aquí es SOLO LECTURA + el sello `avisada_at`: los grants de `prisma_seguros`
// sobre esa tabla son exactamente `SELECT, UPDATE`. No hay INSERT ni DELETE, y
// declararlos en el cliente no los concedería: fallaría en la BD, que es donde
// tiene que fallar. Quien crea obligaciones es el portal, con su propio rol.
//
// Se declara sin relaciones a `portal_identidad` / `portal_bien` a propósito:
// esos modelos no existen en este schema (el corredor no los necesita) y una
// relación a un modelo ausente no compila. Los ids quedan como escalares.
enum PortalObligacionTipo {
  poliza
  itv
  carnet
  recibo
  mantenimiento
  revision_gas
  libre

  @@map("portal_obligacion_tipo")
}

enum PortalProcedencia {
  compania
  calculado
  declarado
  documento

  @@map("portal_procedencia")
}

model PortalObligacion {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId       String               @map("identidad_id") @db.Uuid
  bienId            String?              @map("bien_id") @db.Uuid
  /// La póliza de la CARTERA que originó la obligación. Es el ÚNICO camino que
  /// el corredor tiene hasta el destinatario: póliza → cliente → cliente_emails.
  /// NULL (una póliza declarada por el usuario) = no hay a quién escribir desde
  /// aquí; eso se cuenta como «sin canal», nunca como «no hace falta avisar».
  polizaId          String?              @map("poliza_id") @db.Uuid
  polizaDeclaradaId String?              @map("poliza_declarada_id") @db.Uuid
  tipo              PortalObligacionTipo
  titulo            String
  fechaEvento       DateTime             @map("fecha_evento") @db.Date
  /// `fechaEvento` − DIAS_PREAVISO_TOMADOR. Es la fecha que se le dice al cliente.
  fechaAccionable   DateTime             @map("fecha_accionable") @db.Date
  procedencia       PortalProcedencia
  confirmadaAt      DateTime?            @map("confirmada_at") @db.Timestamptz(6)
  /// Sello del envío. Que exista es lo único que impide avisar dos veces.
  avisadaAt         DateTime?            @map("avisada_at") @db.Timestamptz(6)
  creadaAt          DateTime             @default(now()) @map("creada_at") @db.Timestamptz(6)
  actualizadaAt     DateTime             @default(now()) @map("actualizada_at") @db.Timestamptz(6)

  @@unique([identidadId, polizaId])
  @@index([identidadId])
  @@map("portal_obligacion")
}

// ─── El PARTE de siniestro del portal, visto desde el panel del corredor ────
// Espejo de `seguros.portal_parte_siniestro` (DDL y motivos en
// `apps/asegura-portal/prisma/sql/2026-09-03_portal_parte_siniestro.sql`).
//
// 🚨 Un parte NO es un siniestro: es la DECLARACIÓN de uno. Entre los dos hay
// un paso humano —Alberto lo abre en la entidad— y mientras no ocurra, la
// compañía NO sabe nada. Qué estado autoriza a decir lo contrario lo decide
// `comunicadoACompania()` de `@central/module-seguros-portal`, nunca un
// `estado !== 'enviado'` escrito a mano aquí o aguas abajo.
//
// 🚨 Aquí es LECTURA + el movimiento de estado: los grants de `prisma_seguros`
// sobre esa tabla son exactamente `SELECT, UPDATE`. Quien INSERTA es el portal,
// con su propio rol. (Los DEFAULT PRIVILEGES del schema le dan de hecho DML
// completo; declarar aquí más de lo que toca sería apoyarse en eso.)
//
// Sin relaciones a `portal_identidad` ni a `portal_poliza_declarada`: esos
// modelos no existen en este schema —el corredor no los necesita— y una
// relación a un modelo ausente no compila. Los ids quedan como escalares, igual
// que `PortalObligacion.polizaId`.
enum PortalParteEstado {
  enviado
  recibido
  abierto_en_compania
  descartado

  @@map("portal_parte_estado")
}

model PortalParteSiniestro {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Quién lo mandó. La ficha de la cartera detrás (si la hay) sale de
  /// `portal_vinculo`; sin fila ahí no sabemos quién es, y eso se dice.
  identidadId         String            @map("identidad_id") @db.Uuid
  /// Póliza de la CARTERA. Puede ser de OTRO cliente que le autorizó a verla.
  polizaId            String?           @map("poliza_id") @db.Uuid
  polizaDeclaradaId   String?           @map("poliza_declarada_id") @db.Uuid
  descripcion         String
  /// NOT NULL: sin ella no hay plazo del art. 16 LCS que contar.
  fechaHecho          DateTime          @map("fecha_hecho") @db.Date
  /// `HH:MM` y APROXIMADA. Texto, no `time`: una hora inventada es peor que ninguna.
  horaAproximada      String?           @map("hora_aproximada")
  lugar               String?
  /// 🚨 `null` = no lo ha contestado; `false` = ha dicho que no. No se colapsan:
  /// un parte con heridos se tramita en horas y otro espera al lunes.
  hayHeridos          Boolean?          @map("hay_heridos")
  hayTerceros         Boolean?          @map("hay_terceros")
  estado              PortalParteEstado @default(enviado)
  /// El siniestro REAL, cuando exista. `null` = la compañía todavía no lo sabe.
  siniestroId         String?           @map("siniestro_id") @db.Uuid
  recibidoAt          DateTime?         @map("recibido_at") @db.Timestamptz(6)
  abiertoEnCompaniaAt DateTime?         @map("abierto_en_compania_at") @db.Timestamptz(6)
  descartadoAt        DateTime?         @map("descartado_at") @db.Timestamptz(6)
  motivoDescarte      String?           @map("motivo_descarte")
  creadoEn            DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime          @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@index([identidadId])
  @@map("portal_parte_siniestro")
}

/// El consentimiento de un cliente para que OTRO vea sus seguros
/// (`seguros.portal_autorizacion`). El corredor la ve, la anota cuando el
/// cliente se lo da por teléfono, y la puede revocar — pero NO la concede en
/// nombre de nadie: por eso `origen` distingue de dónde salió, y una anotada
/// por la correduría sigue sin abrir nada hasta que el autorizado la ACEPTE
/// en el portal. Reglas puras en `@central/module-seguros-portal/autorizacion`.
model PortalAutorizacion {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId           String    @map("correduria_id") @db.Uuid
  otorganteClienteId     String    @map("otorgante_cliente_id") @db.Uuid
  autorizadoClienteId    String    @map("autorizado_cliente_id") @db.Uuid
  alcance                String
  /// Con qué título representa a la SOCIEDAD quien recibe el apoderamiento
  /// (`administrador` | `apoderado` | `empleado_autorizado`). `null` = no consta;
  /// el CHECK `portal_autorizacion_apoderamiento_con_titulo` lo exige en cuanto el
  /// alcance es `partes` o `documentos`. Las de una persona física van siempre a `null`.
  tituloRepresentacion   String?   @map("titulo_representacion")
  origen                 String    @default("portal")
  otorgadoEn             DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(6)
  otorgadoPorIdentidadId String?   @map("otorgado_por_identidad_id") @db.Uuid
  otorgadoPorActor       String?   @map("otorgado_por_actor")
  aceptadoEn             DateTime? @map("aceptado_en") @db.Timestamptz(6)
  aceptadoPorIdentidadId String?   @map("aceptado_por_identidad_id") @db.Uuid
  caducaEn               DateTime  @map("caduca_en") @db.Timestamptz(6)
  revocadoEn             DateTime? @map("revocado_en") @db.Timestamptz(6)
  /// `otorgante` | `autorizado` | `corredor` | `caducidad`. `caducidad` no es una
  /// revocación: cierra una ya caducada para liberar el índice único al renovarla.
  revocadoPor            String?   @map("revocado_por")
  revocadoPorIdentidadId String?   @map("revocado_por_identidad_id") @db.Uuid
  revocadoPorActor       String?   @map("revocado_por_actor")
  versionTexto           String    @map("version_texto")
  ip                     String?   @db.Inet
  userAgent              String?   @map("user_agent")

  @@index([otorganteClienteId])
  @@index([autorizadoClienteId])
  @@map("portal_autorizacion")
}

// ─── Lo que el asegurado tiene EN EL PORTAL, visto desde el panel del corredor ──
// Espejo de las tablas `portal_*` que llenan `apps/asegura-portal` y su rol
// `prisma_asegura_portal`. Aquí son **solo lectura**: existen para poder montar
// el paquete del derecho de acceso (art. 15 RGPD) y de portabilidad (art. 20),
// que se sirve por `/api/operador/export-rgpd`.
//
// 🚨 Por qué lo sirve ESTA app y no el portal: el rol del portal es
// deliberadamente estrecho (sin BYPASSRLS, con GRANT por columnas) y **no puede
// leer la cartera entera**. Darle permisos para un export sería abrir de par en
// par, para un caso al año, lo que está cerrado el resto del tiempo — y un
// secuestro de sesión se llevaría de golpe todo lo que hoy no alcanza.
//
// Sin relaciones, como sus tres hermanos de arriba: ids escalares, porque parte
// de los modelos del portal no existen en este schema.

enum PortalCanalTipo {
  email
  whatsapp

  @@map("portal_canal_tipo")
}

enum PortalBienTipo {
  vehiculo
  vivienda
  otro

  @@map("portal_bien_tipo")
}

model PortalIdentidad {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String?
  creadaEn       DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  ultimoAccesoEn DateTime? @map("ultimo_acceso_en") @db.Timestamptz(6)

  @@map("portal_identidad")
}

// 🔒 `valor_hash` NO se declara a propósito: es el correo pasado por HMAC y no
// se puede deshacer. Enseñárselo al interesado como «tu correo» sería devolver
// basura; el export lo dice con palabras en su lugar.
model PortalCanal {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId  String          @map("identidad_id") @db.Uuid
  tipo         PortalCanalTipo
  verificadoEn DateTime?       @map("verificado_en") @db.Timestamptz(6)
  creadoEn     DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("portal_canal")
}

model PortalBien {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId String         @map("identidad_id") @db.Uuid
  tipo        PortalBienTipo
  nombre      String
  datos       Json           @default("{}")
  creadoEn    DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("portal_bien")
}

model PortalPolizaDeclarada {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId          String            @map("identidad_id") @db.Uuid
  bienId               String?           @map("bien_id") @db.Uuid
  compania             String?
  numeroPoliza         String?           @map("numero_poliza")
  ramo                 String?
  primaAnual           Decimal?          @map("prima_anual") @db.Decimal(10, 2)
  fechaVencimiento     DateTime?         @map("fecha_vencimiento") @db.Date
  matricula            String?
  bastidor             String?
  fechaMatriculacion   DateTime?         @map("fecha_matriculacion") @db.Date
  referenciaCatastral  String?           @map("referencia_catastral")
  datosRamo            Json?             @map("datos_ramo")
  datosRamoOrigen      Json?             @map("datos_ramo_origen")
  procedencia          PortalProcedencia @default(declarado)
  confirmadaPorUsuario Boolean           @default(false) @map("confirmada_por_usuario")
  documentoNombre      String?           @map("documento_nombre")
  creadaEn             DateTime          @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn        DateTime          @default(now()) @map("actualizada_en") @db.Timestamptz(6)

  @@map("portal_poliza_declarada")
}

model PortalVinculo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId  String   @map("identidad_id") @db.Uuid
  correduriaId String   @map("correduria_id") @db.Uuid
  clienteId    String   @map("cliente_id") @db.Uuid
  nivel        String   @default("gestionar")
  origen       String
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@unique([identidadId, clienteId])
  @@map("portal_vinculo")
}

model PortalConsentimiento {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId  String   @map("identidad_id") @db.Uuid
  tipo         String
  otorgado     Boolean
  versionTexto String   @map("version_texto")
  ip           String?  @db.Inet
  userAgent    String?  @map("user_agent")
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("portal_consentimiento")
}

/// Las solicitudes del derecho de SUPRESIÓN que llegan por el portal del cliente.
///
/// 🚨 No es una cola de borrados: es una cola de RESPUESTAS con un plazo legal de
/// un mes corriendo por debajo (art. 12.3 RGPD). Aquí sí se ESCRIBE —resolverla
/// es trabajo del corredor, no del portal—, a diferencia del resto de modelos
/// `portal_*` de este schema, que son de solo lectura.
model PortalSupresion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId   String    @map("correduria_id") @db.Uuid
  identidadId    String    @map("identidad_id") @db.Uuid
  /// `null` NO es «no es cliente»: es «su acceso no está enlazado con ninguna
  /// ficha». Un lead también ejerce el derecho.
  clienteId      String?   @map("cliente_id") @db.Uuid
  recibidaEn     DateTime  @default(now()) @map("recibida_en") @db.Timestamptz(6)
  estado         String    @default("recibida")
  prorrogadaEn   DateTime? @map("prorrogada_en") @db.Timestamptz(6)
  prorrogaMotivo String?   @map("prorroga_motivo")
  resueltaEn     DateTime? @map("resuelta_en") @db.Timestamptz(6)
  respuesta      String?
  resueltaPor    String?   @map("resuelta_por")
  motivo         String?
  versionTextos  String    @map("version_textos")
  ip             String?   @db.Inet
  userAgent      String?   @map("user_agent")

  @@index([estado, recibidaEn])
  @@map("portal_supresion")
}
