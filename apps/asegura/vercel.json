{
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs apps/asegura --sin-previews",
  "github": {
    "silent": true
  },
  "buildCommand": "prisma generate && prisma generate --schema prisma/asegura.prisma && next build",
  "installCommand": "npx --yes pnpm@10.33.0 install --no-frozen-lockfile",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/avisos-vencimiento",
      "schedule": "0 8 * * *"
    }
  ]
}
