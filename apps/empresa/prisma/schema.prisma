// Schema `herramientas` («Mi empresa»). La VERDAD del esquema es prisma/sql/*.sql (se aplica a mano; nunca `prisma migrate`/`db push`).
// La app habla con la BD por SQL parametrizado ($queryRaw/$executeRaw con plantilla): lecturas dentro de `conPersona()` (RLS) y
// escrituras SOLO por funciones SECURITY DEFINER. Aquí solo se modela `cuenta` para que el cliente exista.
// 🚨 Rol `prisma_herramientas` (NOBYPASSRLS): sin GRANT en ningún otro schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["herramientas"]
}

model Cuenta {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cif          String   @unique
  razonSocial  String   @map("razon_social")
  activo       Boolean  @default(true)
  creadaEn     DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  @@map("cuenta")
  @@schema("herramientas")
}
