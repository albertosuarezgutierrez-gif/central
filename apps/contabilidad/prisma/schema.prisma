// Schema `contabilidad`. La VERDAD del esquema es prisma/sql/*.sql (se aplica a mano, nunca `prisma migrate`/`db push`).
// La app habla con la BD por SQL parametrizado (`$queryRaw`/`$executeRaw` con plantilla) dentro de `conEmpresa()` (lib/rls.ts):
// el repositorio (lib/repo.ts) es una interfaz y los tests usan fakes. Aquí solo se modela `empresas` para que el cliente exista.
// Sin relaciones Prisma a propósito: las FK reales son COMPUESTAS (empresa_id, x) y viven en SQL.
// 🚨 Toda consulta pasa por `conEmpresa()`: sin ajuste de sesión, RLS devuelve cero filas.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["contabilidad"]
}

model Empresa {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nif           String   @unique
  razonSocial   String   @map("razon_social")
  forma         String
  sector        String
  regimenIva    String?  @map("regimen_iva")
  moneda        String   @default("EUR")
  logoUrl       String?  @map("logo_url")
  colorPrimario String?  @map("color_primario")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("empresas")
  @@schema("contabilidad")
}
