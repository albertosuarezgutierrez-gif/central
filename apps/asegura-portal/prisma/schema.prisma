  @@map("portal_patrimonio_aviso_inquilino")
  @@schema("seguros")
}

/// Seguro del inmueble: póliza de la cartera O aportada (exactamente una, CHECK). La póliza tiene que estar
/// en la cartera que la identidad VE (`carteraDeIdentidad`): eso lo comprueba el código.
model PortalPatrimonioInmueblePoliza {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inmuebleId           String    @map("inmueble_id") @db.Uuid
  polizaId             String?   @map("poliza_id") @db.Uuid
  polizaDeclaradaId    String?   @map("poliza_declarada_id") @db.Uuid
  creadoEn             DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId String?   @map("creado_por_identidad_id") @db.Uuid
  archivadoEn          DateTime? @map("archivado_en") @db.Timestamptz(6)
  /// `confirmado` | `rechazado` (CHECK; 24/10/2026). Un «No es este» queda escrito para no volver a proponerlo.
  /// Sin `@default` de Prisma: el código lo escribe SIEMPRE (el DEFAULT de la BD solo cubre filas viejas).
  estado               String
  /// `manual` | `propuesta_refcat` | `propuesta_direccion` (CHECK). Lo decide el servidor (`origenAEscribir`).
  origen               String

  inmueble PortalPatrimonioInmueble @relation(fields: [inmuebleId], references: [id])

  @@map("portal_patrimonio_inmueble_poliza")
  @@schema("seguros")
}

/// Mensajes cliente ↔ corredor (ASegura OS §Q.7, 24/09/2026). Un hilo por póliza (NULL = general).
/// El rol solo tiene SELECT, INSERT y UPDATE(leido_at): lo escrito no se edita ni se borra.
