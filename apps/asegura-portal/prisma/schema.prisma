/// GRANT: sin lugar_direccion (cifrada), comentario (interno), reservas ni indemnizaciones.
model Siniestro {
  id                 String             @id @db.Uuid
  correduriaId       String             @map("correduria_id") @db.Uuid
  clienteId          String             @map("cliente_id") @db.Uuid
  polizaId           String             @map("poliza_id") @db.Uuid
  estado             EstadoSiniestro
  tipo               String?            @db.VarChar(60)
  referencia         String?            @db.VarChar(100)
  /// QUÉ pasó, en texto libre del tramitador. GRANT concedido el 07/09/2026
  /// (`prisma/sql/2026-09-07_portal_siniestro_descripcion.sql`): el orden es
  /// primero el GRANT y después esta línea — al revés, la lectura ENTERA de
  /// `Siniestro` revienta con `permission denied for column` (42501).
  comentario         String?
  fechaHora          DateTime?          @map("fecha_hora") @db.Timestamptz(6)
  lugarCp            String?            @map("lugar_cp") @db.VarChar(10)
  lugarCiudad        String?            @map("lugar_ciudad") @db.VarChar(100)
  lugarProvincia     String?            @map("lugar_provincia") @db.VarChar(100)
  /// Tramitación que manda la COMPAÑÍA por EIAC (la escribe el CRM, repo asegura,
  /// migración 0099). GRANT por columnas del 24/09/2026. `reserva_cima` y
  /// `posicion_cima` NO se declaran a propósito: sin grant, y no son del cliente.
  situacionesCima    Json?              @map("situaciones_cima")
  accionesCima       Json?              @map("acciones_cima")
  pagosCima          Json?              @map("pagos_cima")
  indemnizacionCima  Decimal?           @map("indemnizacion_cima") @db.Decimal(12, 2)
  totalPagosCima     Decimal?           @map("total_pagos_cima") @db.Decimal(12, 2)
  /// TODO el siniestro para el cliente (28/09/2026, «el seguro es suyo, tiene que
  /// saber todo»). GRANT por columnas aplicado ANTES de declararlas. Siguen FUERA
  /// `contacto_nombre_cima`/`contacto_telefono_cima` (cifrados) y `ref_mediador_cima`.
  fechaDeclaracion   DateTime?          @map("fecha_declaracion") @db.Date
  posicionCima       String?            @map("posicion_cima") @db.VarChar(10)
  responsabilidadCima String?           @map("responsabilidad_cima") @db.VarChar(40)
  daaCima            Boolean?           @map("daa_cima")
  reservaCima        Decimal?           @map("reserva_cima") @db.Decimal(12, 2)
  reservaDesgloseCima Json?             @map("reserva_desglose_cima")
  totalRecobrosCima  Decimal?           @map("total_recobros_cima") @db.Decimal(12, 2)
  expedientesCima    Json?              @map("expedientes_cima")
  riesgoCima         Json?              @map("riesgo_cima")
  vehiculoCima       Json?              @map("vehiculo_cima")
  vehiculoContrarioCima Json?           @map("vehiculo_contrario_cima")
  asistenciasCima    Json?              @map("asistencias_cima")
  descripcionCima    String?            @map("descripcion_cima")
  tramitadorNombre   String?            @map("tramitador_nombre") @db.VarChar(255)
  tramitadorTelefono String?            @map("tramitador_telefono") @db.VarChar(30)
  tramitadorEmail    String?            @map("tramitador_email") @db.VarChar(255)
  peritoNombre       String?            @map("perito_nombre") @db.VarChar(255)
  peritoTelefono     String?            @map("perito_telefono") @db.VarChar(30)
  peritoEmail        String?            @map("perito_email") @db.VarChar(255)
  origen             SiniestroOrigen
  idSiniestroEntidad String?            @map("id_siniestro_entidad") @db.VarChar(50)
  gravedad           SiniestroGravedad?
  createdAt          DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(6)
  /// Alta manual unida a un siniestro de CIMA (SQL 2026-10-03d de apps/asegura, con su GRANT).
  /// La lectura del portal filtra `null`: si no, el cliente vería el mismo siniestro dos veces.
  fusionadoEnSiniestroId String?        @map("fusionado_en_siniestro_id") @db.Uuid

  @@map("siniestros")
  @@schema("seguros")
}

