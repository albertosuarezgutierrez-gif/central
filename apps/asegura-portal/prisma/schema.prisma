/// Gasto imputado. Solo cuenta `confirmado`; descartar = `estado`, nunca DELETE. Índice único parcial
/// (`titular_id`, `clave`) en BD: el generador es idempotente (P2002 tolerado).
model PortalPatrimonioGasto {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titularId                String    @map("titular_id") @db.Uuid
  inmuebleId               String?   @map("inmueble_id") @db.Uuid
  fecha                    DateTime  @db.Date
  categoria                String?
  concepto                 String?
  baseCent                 BigInt?   @map("base_cent")
  totalCent                BigInt?   @map("total_cent")
  estado                   String    @default(dbgenerated("'propuesto'::text"))
  origen                   String
  clave                    String?
  documentoId              String?   @map("documento_id") @db.Uuid
  propuesta                Json?
  confirmadoEn             DateTime? @map("confirmado_en") @db.Timestamptz(6)
  confirmadoPorIdentidadId String?   @map("confirmado_por_identidad_id") @db.Uuid
  creadoEn                 DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn            DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId     String?   @map("creado_por_identidad_id") @db.Uuid

  titular  PortalPatrimonioTitular   @relation(fields: [titularId], references: [id])
  inmueble PortalPatrimonioInmueble? @relation(fields: [inmuebleId], references: [id])

  @@map("portal_patrimonio_gasto")
  @@schema("seguros")
}

/// Fichero (PDF/JPG/PNG/WebP, ≤ 10 MB) de un inmueble, contrato o inquilino, guardado EN BD (decisión de Alberto,
/// 22/10/2026). Cuelga de exactamente un owner del MISMO titular (FK compuesta en BD). Sin DELETE: borrar es sellar
/// `borradoEn`/`borradoPorIdentidadId` (único UPDATE concedido). 🚨 Las LISTAS nunca seleccionan `contenido`: solo la descarga.
/// Sin relaciones Prisma a propósito: el aislamiento lo dan las FK compuestas y `accesosPatrimonio`.
model PortalPatrimonioDocumento {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titularId             String    @map("titular_id") @db.Uuid
  inmuebleId            String?   @map("inmueble_id") @db.Uuid
  contratoId            String?   @map("contrato_id") @db.Uuid
  inquilinoId           String?   @map("inquilino_id") @db.Uuid
  carpeta               String
  nombre                String
  mime                  String
  sizeBytes             Int       @map("size_bytes")
  sha256                String
  contenido             Bytes
  creadoPorIdentidadId  String?   @map("creado_por_identidad_id") @db.Uuid
  creadoEn              DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  borradoEn             DateTime? @map("borrado_en") @db.Timestamptz(6)
  borradoPorIdentidadId String?   @map("borrado_por_identidad_id") @db.Uuid

  @@map("portal_patrimonio_documento")
  @@schema("seguros")
}

/// Índices IPC/IRAV del INE. El portal SOLO LEE (lo escribe el cron de `apps/asegura`); append-only:
/// una revisión es fila nueva con `revisado=true`. El lector toma la más reciente por `descargadoEn`.
model PortalPatrimonioIndice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indice       String
  periodo      String   @db.Char(7)
  pct          Decimal  @db.Decimal(6, 3)
  fuenteUrl    String   @map("fuente_url")
  descargadoEn DateTime @default(dbgenerated("now()")) @map("descargado_en") @db.Timestamptz(6)
  revisado     Boolean  @default(dbgenerated("false"))
  creadoEn     DateTime @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)

  @@map("portal_patrimonio_indice")
  @@schema("seguros")
}

/// Importación de Excel/CSV. Nada de aquí cuenta hasta `confirmada` (cepo de los pasos 10-11).
model PortalPatrimonioImportacion {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId          String    @map("identidad_id") @db.Uuid
  titularId            String    @map("titular_id") @db.Uuid
  documentoId          String?   @map("documento_id") @db.Uuid
  mapeo                Json?
  estado               String    @default(dbgenerated("'propuesta'::text"))
  confirmadaEn         DateTime? @map("confirmada_en") @db.Timestamptz(6)
  creadoEn             DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId String?   @map("creado_por_identidad_id") @db.Uuid
  /// 'inmueble' | 'contrato' | 'gasto'. null = aún sin decidir. Requiere `2026-10-26_portal_patrimonio_importacion_fichero.sql`.
  tipo                 String?
  /// sha-256 del fichero subido (el fichero NO se guarda): evita dos importaciones abiertas del mismo fichero.
  ficheroHash          String?   @map("fichero_hash") @db.Char(64)
  ficheroNombre        String?   @map("fichero_nombre")
  filasTotal           Int?      @map("filas_total")
  /// Recuento al confirmar (auditoría): creadas, yaExistian, repetidas, apartadas, porValidar.
  resultado            Json?

  titular PortalPatrimonioTitular           @relation(fields: [titularId], references: [id])
  filas   PortalPatrimonioImportacionFila[]

  @@map("portal_patrimonio_importacion")
  @@schema("seguros")
}

model PortalPatrimonioImportacionFila {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importacionId        String   @map("importacion_id") @db.Uuid
  n                    Int
  entidad              String
  /// Tránsito de la vista previa, SIN NIF/email/teléfono (van cifrados por el puente). La BD lo vacía (null)
  /// al confirmar/descartar la importación y rechaza escribirlo en una cerrada.
  datos                Json?
  problema             String?
  creadoId             String?  @map("creado_id") @db.Uuid
  creadoEn             DateTime @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId String?  @map("creado_por_identidad_id") @db.Uuid

  importacion PortalPatrimonioImportacion @relation(fields: [importacionId], references: [id])

  @@unique([importacionId, n])
  @@map("portal_patrimonio_importacion_fila")
  @@schema("seguros")
}

/// Obligación del INMUEBLE (ITE, certificado energético, gas…). Las de contrato se CALCULAN.
/// `aplica` false = no aplica; null = no se sabe (sale `sin_dato`).
model PortalPatrimonioObligacion {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inmuebleId           String    @map("inmueble_id") @db.Uuid
  tipo                 String
  descripcion          String?
  aplica               Boolean?
  ultima               DateTime? @db.Date
  vence                DateTime? @db.Date
  periodicidadMeses    Int?      @map("periodicidad_meses") @db.SmallInt
  avisadaEn            DateTime? @map("avisada_en") @db.Timestamptz(6)
  creadoEn             DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId String?   @map("creado_por_identidad_id") @db.Uuid
  archivadoEn          DateTime? @map("archivado_en") @db.Timestamptz(6)
  /// Recordatorio PROPIO del cliente (catálogo cerrado, `obligacion-propia.ts`). NULL = obligación de siempre.
  /// Requiere `2026-10-25_portal_patrimonio_obligacion_propia.sql` aplicado ANTES del despliegue.
  categoria            String?

  inmueble PortalPatrimonioInmueble @relation(fields: [inmuebleId], references: [id])

  @@map("portal_patrimonio_obligacion")
  @@schema("seguros")
}

/// Enlace del inquilino. Token HASHEADO; anular NO borra (solo UPDATE de `anuladoEn`/`ultimoUsoEn`).
