generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["seguros"]
}

// Los tres ENUM de Postgres que ya crea `prisma/sql/2026-09-01_portal_fase1.sql`.
// ⚠️ Declararlos aquí como `String` compilaba pero reventaba en el primer INSERT:
// Prisma manda el parámetro tipado como `text` y Postgres rechaza `text` contra
// una columna de tipo enum (42804). No hay migración: la BD ya los tiene así.
enum PortalCanalTipo {
  whatsapp
  email

  @@map("portal_canal_tipo")
  @@schema("seguros")
}

enum PortalProcedencia {
  compania
  calculado
  declarado
  /// Añadida a la BD el 02/09/2026 (`2026-09-02_portal_rol_vinculo_grants.sql`): el módulo la definía y la BD no.
  documento

  @@map("portal_procedencia")
  @@schema("seguros")
}

enum PortalBienTipo {
  vehiculo
  vivienda
  local
  mascota
  persona
  empresa

  @@map("portal_bien_tipo")
  @@schema("seguros")
}

/// Qué vence. v1 solo emite `poliza`; el enum nace con sitio para el resto
/// porque una obligación cuelga del BIEN y el motor es el mismo para la ITV de
/// un coche que para el vencimiento de su seguro.
enum PortalObligacionTipo {
  poliza
  itv
  carnet
  recibo
  mantenimiento
  revision_gas
  libre

  @@map("portal_obligacion_tipo")
  @@schema("seguros")
}

/// El ciclo de vida de un parte declarado por el cliente.
///
/// 🚨 `enviado` y `recibido` NO significan que la compañía lo sepa: la
/// correduría es mediadora del cliente, no del asegurador. Solo
/// `abierto_en_compania` —y la BD exige sello y `siniestro_id` para ponerlo—
/// autoriza a decírselo. Ver `comunicadoACompania()` en
/// `@central/module-seguros-portal`.
enum PortalParteEstado {
  enviado
  recibido
  abierto_en_compania
  descartado

  @@map("portal_parte_estado")
  @@schema("seguros")
}

model PortalIdentidad {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String?
  creadaEn       DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  ultimoAccesoEn DateTime? @map("ultimo_acceso_en") @db.Timestamptz(6)

  canales      PortalCanal[]
  bienes       PortalBien[]
  polizas      PortalPolizaDeclarada[]
  vinculos     PortalVinculo[]
  obligaciones PortalObligacion[]
  partes       PortalParteSiniestro[]

  @@map("portal_identidad")
  @@schema("seguros")
}

model PortalCanal {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId  String          @map("identidad_id") @db.Uuid
  tipo         PortalCanalTipo
  valorHash    String          @map("valor_hash")
  verificadoEn DateTime?       @map("verificado_en") @db.Timestamptz(6)
  creadoEn     DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)

  identidad PortalIdentidad @relation(fields: [identidadId], references: [id], onDelete: Cascade)

  @@unique([tipo, valorHash])
  @@map("portal_canal")
  @@schema("seguros")
}

model PortalCodigo {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo      PortalCanalTipo
  valorHash String          @map("valor_hash")
  codigo    String
  intentos  Int             @default(0)
  creadoEn  DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)
  usadoEn   DateTime?       @map("usado_en") @db.Timestamptz(6)

  @@map("portal_codigo")
  @@schema("seguros")
}

model PortalBien {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId String         @map("identidad_id") @db.Uuid
  tipo        PortalBienTipo
  nombre      String
  datos       Json           @default("{}")
  creadoEn    DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)

  identidad    PortalIdentidad         @relation(fields: [identidadId], references: [id], onDelete: Cascade)
  polizas      PortalPolizaDeclarada[]
  obligaciones PortalObligacion[]

  @@map("portal_bien")
  @@schema("seguros")
}

model PortalPolizaDeclarada {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId          String            @map("identidad_id") @db.Uuid
  bienId               String?           @map("bien_id") @db.Uuid
  compania             String?
  numeroPoliza         String?           @map("numero_poliza")
  ramo                 String?
  primaAnual           Decimal?          @map("prima_anual") @db.Decimal(10, 2)
  fechaVencimiento     DateTime?         @map("fecha_vencimiento") @db.Date
  procedencia          PortalProcedencia @default(declarado)
  confirmadaPorUsuario Boolean           @default(false) @map("confirmada_por_usuario")
  documentoNombre      String?           @map("documento_nombre")
  extraccionBruta      Json?             @map("extraccion_bruta")
  creadaEn             DateTime          @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn        DateTime          @default(now()) @map("actualizada_en") @db.Timestamptz(6)

  identidad PortalIdentidad        @relation(fields: [identidadId], references: [id], onDelete: Cascade)
  bien      PortalBien?            @relation(fields: [bienId], references: [id])
  partes    PortalParteSiniestro[]

  @@map("portal_poliza_declarada")
  @@schema("seguros")
}

model PortalObligacion {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId       String               @map("identidad_id") @db.Uuid
  bienId            String?              @map("bien_id") @db.Uuid
  /// La póliza de la CARTERA. Sin relación de Prisma: el rol del portal no
  /// escribe en `polizas` y una FK ataría su borrado.
  polizaId          String?              @map("poliza_id") @db.Uuid
  polizaDeclaradaId String?              @map("poliza_declarada_id") @db.Uuid
  tipo              PortalObligacionTipo
  titulo            String
  /// La fecha del hecho. NOT NULL a propósito: sin fecha no hay obligación.
  fechaEvento       DateTime             @map("fecha_evento") @db.Date
  /// `fechaEvento` − DIAS_PREAVISO_TOMADOR. Es la que se le enseña al cliente.
  fechaAccionable   DateTime             @map("fecha_accionable") @db.Date
  procedencia       PortalProcedencia
  confirmadaAt      DateTime?            @map("confirmada_at") @db.Timestamptz(6)
  /// Sello del envío. Que exista es lo que impide avisar dos veces.
  avisadaAt         DateTime?            @map("avisada_at") @db.Timestamptz(6)
  creadaAt          DateTime             @default(now()) @map("creada_at") @db.Timestamptz(6)
  actualizadaAt     DateTime             @default(now()) @map("actualizada_at") @db.Timestamptz(6)

  identidad PortalIdentidad @relation(fields: [identidadId], references: [id], onDelete: Cascade)
  bien      PortalBien?     @relation(fields: [bienId], references: [id])

  @@unique([identidadId, polizaId])
  @@index([identidadId])
  @@map("portal_obligacion")
  @@schema("seguros")
}

/// El parte que abre el CLIENTE. Es una DECLARACIÓN de siniestro, no un
/// siniestro: `seguros.siniestros` es la cartera que llena CIMA y el rol del
/// portal no escribe en ella. DDL y motivos en
/// `prisma/sql/2026-09-03_portal_parte_siniestro.sql`.
///
/// El portal solo INSERTA y LEE lo suyo: no hay UPDATE ni DELETE para el
/// cliente, porque lo declarado es una comunicación y no un borrador.
model PortalParteSiniestro {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId         String            @map("identidad_id") @db.Uuid
  /// Póliza de la CARTERA. Sin relación de Prisma: el rol no escribe en `polizas`.
  polizaId            String?           @map("poliza_id") @db.Uuid
  polizaDeclaradaId   String?           @map("poliza_declarada_id") @db.Uuid
  descripcion         String
  /// NOT NULL: sin ella no hay plazo del art. 16 LCS que contar.
  fechaHecho          DateTime          @map("fecha_hecho") @db.Date
  /// `HH:MM` y APROXIMADA. Texto, no `time`: una hora inventada es peor que ninguna.
  horaAproximada      String?           @map("hora_aproximada")
  lugar               String?
  /// 🚨 `null` = no lo ha contestado; `false` = ha dicho que no. No se colapsan.
  hayHeridos          Boolean?          @map("hay_heridos")
  hayTerceros         Boolean?          @map("hay_terceros")
  estado              PortalParteEstado @default(enviado)
  /// El siniestro REAL, cuando exista. `null` = la compañía todavía no lo sabe.
  siniestroId         String?           @map("siniestro_id") @db.Uuid
  recibidoAt          DateTime?         @map("recibido_at") @db.Timestamptz(6)
  abiertoEnCompaniaAt DateTime?         @map("abierto_en_compania_at") @db.Timestamptz(6)
  descartadoAt        DateTime?         @map("descartado_at") @db.Timestamptz(6)
  motivoDescarte      String?           @map("motivo_descarte")
  creadoEn            DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime          @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  identidad       PortalIdentidad        @relation(fields: [identidadId], references: [id], onDelete: Cascade)
  polizaDeclarada PortalPolizaDeclarada? @relation(fields: [polizaDeclaradaId], references: [id])

  @@index([identidadId])
  @@map("portal_parte_siniestro")
  @@schema("seguros")
}

model PortalConsentimiento {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId  String   @map("identidad_id") @db.Uuid
  tipo         String
  otorgado     Boolean
  versionTexto String   @map("version_texto")
  ip           String?  @db.Inet
  userAgent    String?  @map("user_agent")
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("portal_consentimiento")
  @@schema("seguros")
}

// ─── Fase 4: la costura identidad ↔ ficha de la cartera ─────────────────────
// Sin fila aquí, el portal no lee NADA de la cartera para esa identidad. Se
// crea al canjear el código por índice ciego del email (`lib/vinculo.ts`) o a
// mano desde plataforma (`origen = manual`). `nivel` y `origen` son `text` con
// CHECK en la BD (no enum de Postgres): se validan en código contra `NIVELES`.
model PortalVinculo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId  String   @map("identidad_id") @db.Uuid
  correduriaId String   @map("correduria_id") @db.Uuid
  clienteId    String   @map("cliente_id") @db.Uuid
  nivel        String   @default("gestionar")
  origen       String
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  identidad PortalIdentidad @relation(fields: [identidadId], references: [id], onDelete: Cascade)

  @@unique([identidadId, clienteId])
  @@map("portal_vinculo")
  @@schema("seguros")
}

/// El consentimiento de José para que María vea sus seguros. Reglas en
/// `@central/module-seguros-portal/autorizacion`; nada aquí decide nada.
model PortalAutorizacion {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId           String    @map("correduria_id") @db.Uuid
  otorganteClienteId     String    @map("otorgante_cliente_id") @db.Uuid
  autorizadoClienteId    String    @map("autorizado_cliente_id") @db.Uuid
  alcance                String
  /// `portal` = lo concedió el cliente en su pantalla. `corredor` = la correduría
  /// anotó uno recibido por otro canal. No son lo mismo y no se pueden confundir.
  origen                 String    @default("portal")
  otorgadoEn             DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(6)
  otorgadoPorIdentidadId String?   @map("otorgado_por_identidad_id") @db.Uuid
  otorgadoPorActor       String?   @map("otorgado_por_actor")
  aceptadoEn             DateTime? @map("aceptado_en") @db.Timestamptz(6)
  aceptadoPorIdentidadId String?   @map("aceptado_por_identidad_id") @db.Uuid
  caducaEn               DateTime  @map("caduca_en") @db.Timestamptz(6)
  revocadoEn             DateTime? @map("revocado_en") @db.Timestamptz(6)
  /// `otorgante` | `autorizado` | `corredor` | `caducidad`. 🚨 `caducidad` NO es una
  /// revocación: es el cierre de una que YA había caducado, para liberar el sitio del
  /// índice único al renovarla. La fila se queda como historial.
  revocadoPor            String?   @map("revocado_por")
  revocadoPorIdentidadId String?   @map("revocado_por_identidad_id") @db.Uuid
  revocadoPorActor       String?   @map("revocado_por_actor")
  versionTexto           String    @map("version_texto")
  ip                     String?   @db.Inet
  userAgent              String?   @map("user_agent")

  usos PortalAutorizacionUso[]

  @@index([otorganteClienteId])
  @@index([autorizadoClienteId])
  @@map("portal_autorizacion")
  @@schema("seguros")
}

/// Registro de accesos que ve el OTORGANTE: una fila por autorización, identidad
/// y DÍA. Es lo que convierte la autorización en algo real y no un cheque en blanco.
model PortalAutorizacionUso {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autorizacionId String   @map("autorizacion_id") @db.Uuid
  identidadId    String   @map("identidad_id") @db.Uuid
  dia            DateTime @db.Date
  visitas        Int      @default(1)
  primeraEn      DateTime @default(now()) @map("primera_en") @db.Timestamptz(6)
  ultimaEn       DateTime @default(now()) @map("ultima_en") @db.Timestamptz(6)

  autorizacion PortalAutorizacion @relation(fields: [autorizacionId], references: [id], onDelete: Cascade)

  @@unique([autorizacionId, identidadId, dia])
  @@map("portal_autorizacion_uso")
  @@schema("seguros")
}

// ─── Cartera: SOLO LECTURA, y SOLO las columnas que el rol puede leer ───────
// 🚨 El rol `prisma_asegura_portal` tiene `GRANT SELECT (columnas…)` por tabla
// (`prisma/sql/2026-09-02_portal_rol_vinculo_grants.sql`). Prisma pide cada
// columna declarada aquí por su nombre: declarar una que NO esté en el GRANT
// hace fallar la consulta ENTERA en la BD (`permission denied for column`).
// Es a propósito: DNI, IBAN, teléfono, email, direcciones y comentarios
// internos no se pueden leer desde el portal ni queriendo. Esta lista es un
// espejo del SQL, no una elección de UI. Sin relaciones entre modelos: cada
// lectura es una consulta aparte desde `lib/cartera-lectura.ts`.
//
// Los enums se copian de `apps/asegura/prisma/asegura.prisma` con su `@@map`
// (viven en el schema `seguros`). Tipados como String reventarían al comparar.

enum TipoSeguro {
  auto
  moto
  hogar
  vida
  salud
  decesos
  responsabilidad_civil
  comercio
  comunidades
  otros

  @@map("tipo_seguro")
  @@schema("seguros")
}

enum EstadoPoliza {
  activa
  vencida
  cancelada
  en_renovacion
  en_vigor
  fin_riesgo
  recibo_devuelto
  cambio_clave
  anula_al_vencimiento
  competencia

  @@map("estado_poliza")
  @@schema("seguros")
}

enum PolizaOrigen {
  gestionada_correduria
  declarada_usuario
  emitida_codeoscopic

  @@map("poliza_origen")
  @@schema("seguros")
}

enum Fraccionamiento {
  anual
  semestral
  trimestral
  mensual

  @@map("fraccionamiento")
  @@schema("seguros")
}

enum SegmentoCliente {
  cliente
  ex_cliente
  prospecto

  @@map("segmento_cliente")
  @@schema("seguros")
}

enum TipoCliente {
  cliente
  lead
  beneficiario

  @@map("tipo_cliente")
  @@schema("seguros")
}

enum TipoPersona {
  fisica
  juridica

  @@map("tipo_persona")
  @@schema("seguros")
}

enum IntervinienteRol {
  propietario
  conductor_habitual
  conductor_ocasional
  contacto
  beneficiario
  asegurado

  @@map("interviniente_rol")
  @@schema("seguros")
}

enum IntervinienteOrigen {
  manual
  cima

  @@map("interviniente_origen")
  @@schema("seguros")
}

enum ReciboEstado {
  cobrado
  pendiente
  devuelto
  anulado
  emitido

  @@map("recibo_estado")
  @@schema("seguros")
}

enum EstadoSiniestro {
  abierto
  en_tramitacion
  cerrado
  rechazado

  @@map("estado_siniestro")
  @@schema("seguros")
}

enum SiniestroOrigen {
  gestionado_correduria
  cima

  @@map("siniestro_origen")
  @@schema("seguros")
}

enum SiniestroGravedad {
  leve
  moderado
  grave
  muy_grave

  @@map("siniestro_gravedad")
  @@schema("seguros")
}

/// GRANT: (id, nombre). Ni email, ni teléfono, ni credenciales de WhatsApp.
model Correduria {
  id     String @id @db.Uuid
  nombre String @db.VarChar(255)

  @@map("corredurias")
  @@schema("seguros")
}

/// GRANT: sin dni, telefono, email, direccion, fecha_nacimiento, cuenta_bancaria ni notas.
model Cliente {
  id                  String          @id @db.Uuid
  correduriaId        String          @map("correduria_id") @db.Uuid
  nombre              String          @db.VarChar(255)
  apellidos           String          @db.VarChar(255)
  tipo                TipoCliente
  segmento            SegmentoCliente
  tipoPersona         TipoPersona?    @map("tipo_persona")
  activo              Boolean
  importRef           String?         @map("import_ref") @db.VarChar(100)
  emailLookupHash     String?         @map("email_lookup_hash")
  telefonoLookupHash  String?         @map("telefono_lookup_hash")
  mergedIntoClienteId String?         @map("merged_into_cliente_id") @db.Uuid
  createdAt           DateTime        @map("created_at") @db.Timestamp(6)

  @@map("clientes")
  @@schema("seguros")
}

/// GRANT: sin la columna `email` (cifrada). Solo el índice ciego.
model ClienteEmail {
  id              String  @id @db.Uuid
  correduriaId    String  @map("correduria_id") @db.Uuid
  clienteId       String  @map("cliente_id") @db.Uuid
  emailLookupHash String? @map("email_lookup_hash")
  esPrincipal     Boolean @map("es_principal")
  etiqueta        String? @db.VarChar(30)

  @@map("cliente_emails")
  @@schema("seguros")
}

/// GRANT: sin cuenta_bancaria, documento_url, comercial_id ni la cadena de renovaciones.
model Poliza {
  id                 String           @id @db.Uuid
  correduriaId       String           @map("correduria_id") @db.Uuid
  clienteId          String           @map("cliente_id") @db.Uuid
  tipo               TipoSeguro
  aseguradora        String           @db.VarChar(255)
  numeroPoliza       String?          @map("numero_poliza") @db.VarChar(100)
  fechaInicio        DateTime?        @map("fecha_inicio") @db.Date
  fechaVencimiento   DateTime?        @map("fecha_vencimiento") @db.Date
  primaAnual         Decimal?         @map("prima_anual") @db.Decimal(10, 2)
  primaMensual       Decimal?         @map("prima_mensual") @db.Decimal(10, 2)
  primaBruta         Decimal?         @map("prima_bruta") @db.Decimal(10, 2)
  fraccionamiento    Fraccionamiento?
  estado             EstadoPoliza
  situacion          String?          @db.VarChar(4)
  datosEspecificos   Json?            @map("datos_especificos")
  coberturas         Json?
  importRef          String?          @map("import_ref") @db.VarChar(100)
  origen             PolizaOrigen
  idPolizaEntidad    String?          @map("id_poliza_entidad") @db.VarChar(50)
  codigoEntidadDgs   String?          @map("codigo_entidad_dgs") @db.VarChar(16)
  ramoDgs            String?          @map("ramo_dgs") @db.VarChar(8)
  fechaEfectoInicial DateTime?        @map("fecha_efecto_inicial") @db.Date
  /// Huella del último EIAC que escribió la fila. Solo la pone el pipeline de
  /// CIMA, así que es la marca de «la ingesta ha tocado esto» — y con ella se
  /// decide la cartera VIVA (ver `WHERE_CARTERA_VIVA` de @central/module-seguros).
  /// GRANT concedido el 03/09/2026; sin él la consulta entera reventaría.
  eiacXmlHash        String?          @map("eiac_xml_hash") @db.VarChar(64)
  mergedIntoPolizaId String?          @map("merged_into_poliza_id") @db.Uuid
  createdAt          DateTime         @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime         @map("updated_at") @db.Timestamp(6)

  @@map("polizas")
  @@schema("seguros")
}

model PolizaCobertura {
  id                  String    @id @db.Uuid
  correduriaId        String    @map("correduria_id") @db.Uuid
  polizaId            String    @map("poliza_id") @db.Uuid
  numeroOrden         Int?      @map("numero_orden")
  codigo              String?
  descripcion         String?
  capitalAsegurado    String?   @map("capital_asegurado")
  descripcionCapital  String?   @map("descripcion_capital")
  franquicia          String?
  fechaInicio         DateTime? @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin            DateTime? @map("fecha_fin") @db.Timestamptz(6)
  modalidadValoracion String?   @map("modalidad_valoracion")
  datosExtra          Json?     @map("datos_extra")

  @@map("poliza_coberturas")
  @@schema("seguros")
}

/// GRANT: sin iban (cifrado) ni comisiones (dato del corredor, no del cliente).
model PolizaRecibo {
  id                 String        @id @db.Uuid
  correduriaId       String        @map("correduria_id") @db.Uuid
  polizaId           String        @map("poliza_id") @db.Uuid
  situacion          ReciboEstado?
  claseRecibo        String?       @map("clase_recibo")
  fechaEfectoInicial DateTime?     @map("fecha_efecto_inicial") @db.Timestamptz(6)
  fechaEfectoActual  DateTime?     @map("fecha_efecto_actual") @db.Timestamptz(6)
  fechaVencimiento   DateTime?     @map("fecha_vencimiento") @db.Timestamptz(6)
  fechaEmision       DateTime?     @map("fecha_emision") @db.Timestamptz(6)
  fechaSituacion     DateTime?     @map("fecha_situacion") @db.Timestamptz(6)
  /// Importes en TEXT tal cual llegan del EIAC: parsear con `importeEiac()`.
  primaTotal         String?       @map("prima_total")
  primaNeta          String?       @map("prima_neta")
  formaPago          String?       @map("forma_pago")

  @@map("poliza_recibos")
  @@schema("seguros")
}

/// GRANT: sin lugar_direccion (cifrada), comentario (interno), reservas ni indemnizaciones.
model Siniestro {
  id                 String             @id @db.Uuid
  correduriaId       String             @map("correduria_id") @db.Uuid
  clienteId          String             @map("cliente_id") @db.Uuid
  polizaId           String             @map("poliza_id") @db.Uuid
  estado             EstadoSiniestro
  tipo               String?            @db.VarChar(60)
  referencia         String?            @db.VarChar(100)
  fechaHora          DateTime?          @map("fecha_hora") @db.Timestamptz(6)
  lugarCp            String?            @map("lugar_cp") @db.VarChar(10)
  lugarCiudad        String?            @map("lugar_ciudad") @db.VarChar(100)
  lugarProvincia     String?            @map("lugar_provincia") @db.VarChar(100)
  tramitadorNombre   String?            @map("tramitador_nombre") @db.VarChar(255)
  tramitadorTelefono String?            @map("tramitador_telefono") @db.VarChar(30)
  tramitadorEmail    String?            @map("tramitador_email") @db.VarChar(255)
  peritoNombre       String?            @map("perito_nombre") @db.VarChar(255)
  peritoTelefono     String?            @map("perito_telefono") @db.VarChar(30)
  peritoEmail        String?            @map("perito_email") @db.VarChar(255)
  origen             SiniestroOrigen
  idSiniestroEntidad String?            @map("id_siniestro_entidad") @db.VarChar(50)
  gravedad           SiniestroGravedad?
  createdAt          DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(6)

  @@map("siniestros")
  @@schema("seguros")
}

/// GRANT: sin nif, nombre, apellidos, teléfono, email ni fechas (todo cifrado). Solo el papel.
model PolizaInterviniente {
  id           String              @id @db.Uuid
  polizaId     String              @map("poliza_id") @db.Uuid
  correduriaId String              @map("correduria_id") @db.Uuid
  rol          IntervinienteRol
  clienteId    String?             @map("cliente_id") @db.Uuid
  tipoRelacion String?             @map("tipo_relacion") @db.VarChar(60)
  origen       IntervinienteOrigen

  @@map("poliza_intervinientes")
  @@schema("seguros")
}

/// GRANT: sin `observaciones` (texto libre del corredor). Fila A→B con
/// `puede_ver_polizas` = A autoriza a B a ver las pólizas de A.
model ClienteRelacion {
  id              String   @id @db.Uuid
  correduriaId    String   @map("correduria_id") @db.Uuid
  clienteAId      String   @map("cliente_a_id") @db.Uuid
  clienteBId      String   @map("cliente_b_id") @db.Uuid
  tipoRelacion    String   @map("tipo_relacion") @db.VarChar(60)
  // 🚫 `puede_ver_polizas` NO está aquí a propósito (03/09/2026): el consentimiento
  // vive en `PortalAutorizacion` y el rol del portal ya no puede LEER esa columna.
  // Si vuelve al modelo, un `findMany` sin `select` explícito revienta en la BD —
  // que es donde tiene que reventar. Las relaciones se siguen leyendo: son las que
  // le ofrecen a José a quién puede autorizar.
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)

  @@map("cliente_relaciones")
  @@schema("seguros")
}
