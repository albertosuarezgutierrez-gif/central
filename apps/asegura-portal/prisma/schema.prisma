  @@schema("seguros")
}

/// GRANT: sin `observaciones` (texto libre del corredor). Fila A→B con
/// `puede_ver_polizas` = A autoriza a B a ver las pólizas de A.
model ClienteRelacion {
  id              String   @id @db.Uuid
  correduriaId    String   @map("correduria_id") @db.Uuid
  clienteAId      String   @map("cliente_a_id") @db.Uuid
  clienteBId      String   @map("cliente_b_id") @db.Uuid
  tipoRelacion    String   @map("tipo_relacion") @db.VarChar(60)
  // 🚫 `puede_ver_polizas` NO está aquí a propósito (03/09/2026): el consentimiento
  // vive en `PortalAutorizacion` y el rol del portal ya no puede LEER esa columna.
  // Si vuelve al modelo, un `findMany` sin `select` explícito revienta en la BD —
  // que es donde tiene que reventar. Las relaciones se siguen leyendo: son las que
  // le ofrecen a José a quién puede autorizar.
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)

  @@map("cliente_relaciones")
  @@schema("seguros")
}

/// El catálogo de compañías de la DGSFP, con el canal al que acude el asegurado
/// después de un percance.
///
/// 🚨 GRANT: **sin `notas` ni `telefono_fuente`**. Las dos son gestión del
/// corredor —la segunda guarda por qué un número no está y qué falta preguntar—
/// y `telefono_fuente` se REVOCÓ el 05/09/2026 justo para que no se pueda
/// declarar aquí por descuido. Recordatorio de la landmine: declarar una
/// columna no concedida revienta la lectura ENTERA de la tabla con
/// `permission denied for column`, no solo esa columna.
///
/// 📌 Esta tabla NO es cartera de nadie: es un catálogo público de códigos DGS y
/// teléfonos publicados. Por eso su lectura no se filtra por identidad y no
/// entra en la lista de modelos que vigila `test/regression-portal-aislamiento.test.ts`.
model CompaniaDgs {
  codigoDgs            String    @id @map("codigo_dgs") @db.VarChar(16)
  nombreComun          String    @map("nombre_comun") @db.VarChar(255)
  activa               Boolean
  telefonoSiniestros   String?   @map("telefono_siniestros")
  telefonoAsistencia   String?   @map("telefono_asistencia")
  whatsappSiniestros   String?   @map("whatsapp_siniestros")
  /// Ramos para los que vale el WhatsApp (`polizas.tipo`); vacío = todos. Mapfre: solo hogar.
  whatsappSiniestrosRamos String[] @default([]) @map("whatsapp_siniestros_ramos")
  horarioSiniestros    String?   @map("horario_siniestros")
  telefonoVerificadoEn DateTime? @map("telefono_verificado_en") @db.Date

  @@map("companias_dgs")
  @@schema("seguros")
}

/// La solicitud del derecho de SUPRESIÓN (art. 17 RGPD).
///
/// 🚨 No es un borrado y no debe leerse como tal: el art. 17.3.b y el 17.3.e
/// excluyen la supresión cuando hace falta cumplir una obligación legal o
/// defender reclamaciones, y una correduría tiene las dos. Lo que esta tabla
/// soporta es lo que sí es obligatorio: recibir, acusar y contestar en un mes
/// (art. 12.3) diciendo qué se borra y qué se conserva, con su base legal
/// (art. 12.4). Reglas y plazos en `@central/module-seguros-portal/supresion`.
model PortalSupresion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId    String    @map("correduria_id") @db.Uuid
  identidadId     String    @map("identidad_id") @db.Uuid
  /// La ficha de la cartera, si la hay. `null` NO es «no es cliente»: es «su
  /// acceso no está enlazado con ninguna ficha». Un lead también puede pedirlo.
  clienteId       String?   @map("cliente_id") @db.Uuid
  /// Cuando la persona la envió, NO cuando el corredor la abre: es desde donde
  /// corre el mes del art. 12.3.
  recibidaEn      DateTime  @default(now()) @map("recibida_en") @db.Timestamptz(6)
  estado          String    @default("recibida")
  /// Sello de la prórroga del art. 12.3. Se pone al AVISAR, no al decidirla.
  prorrogadaEn    DateTime? @map("prorrogada_en") @db.Timestamptz(6)
  prorrogaMotivo  String?   @map("prorroga_motivo")
  resueltaEn      DateTime? @map("resuelta_en") @db.Timestamptz(6)
  /// Lo que se le contestó. Es lo que acredita el art. 12.4 cuando alguien
  /// pregunte por qué no se borró todo.
  respuesta       String?
  resueltaPor     String?   @map("resuelta_por")
  motivo          String?
  /// Qué versión de los textos legales se le enseñó al pedirlo: sin ella no se
  /// puede reconstruir qué se le dijo que se iba a conservar.
  versionTextos   String    @map("version_textos")
  ip              String?   @db.Inet
  userAgent       String?   @map("user_agent")

  @@index([estado, recibidaEn])
  @@map("portal_supresion")
  @@schema("seguros")
}

/// La HOJA de la nevera y su QR (05/09/2026).
///
/// 🚨 `tokenHash` es el HASH, nunca el token: en claro solo existe dentro del
/// enlace que se mete en el QR. Y no hay `DELETE` concedido sobre estas dos
/// tablas — anular es poner `anuladaEn`, porque quien tenga el papel viejo tiene
/// que poder distinguir «esto ya no vale» de «esto no ha existido nunca».
/// Reglas completas en `packages/module-seguros-portal/src/hoja-qr.ts`.
model PortalHojaQr {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId String    @map("identidad_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  nombre      String?
  creadaEn    DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  anuladaEn   DateTime? @map("anulada_en") @db.Timestamptz(6)
  ultimoUsoEn DateTime? @map("ultimo_uso_en") @db.Timestamptz(6)

  identidad PortalIdentidad      @relation(fields: [identidadId], references: [id], onDelete: Cascade)
  polizas   PortalHojaQrPoliza[]

  @@index([identidadId, creadaEn])
  @@map("portal_hoja_qr")
  @@schema("seguros")
}

/// La selección de una hoja. **Ninguna fila = TODAS**, igual que
/// `portal_autorizacion.poliza_id` NULL — y eso incluye las pólizas futuras.
/// Una fila apunta a una de la cartera O a una aportada, nunca a las dos.
model PortalHojaQrPoliza {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hojaId            String  @map("hoja_id") @db.Uuid
  polizaId          String? @map("poliza_id") @db.Uuid
  polizaDeclaradaId String? @map("poliza_declarada_id") @db.Uuid

  hoja PortalHojaQr @relation(fields: [hojaId], references: [id], onDelete: Cascade)

  @@map("portal_hoja_qr_poliza")
  @@schema("seguros")
}

/// El enlace de un solo uso con el que el CORREDOR abre el portal como lo ve un
/// cliente (`seguros.portal_vista_corredor`). Lo crea asegura; aquí solo se lee
/// y se sella `usadoEn`. Reglas en `@central/module-seguros-portal/vista-corredor`.
model PortalVistaCorredor {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId String    @map("correduria_id") @db.Uuid
  clienteId    String    @map("cliente_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  actor        String
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  usadoEn      DateTime? @map("usado_en") @db.Timestamptz(6)

  @@index([clienteId, creadoEn])
  @@map("portal_vista_corredor")
  @@schema("seguros")
}

/// ─── El presupuesto que se le enseña al cliente (PR 2, 21/09/2026) ──────────
///
/// Las tablas las crea `apps/asegura/prisma/sql/2026-09-21_presupuesto.sql` y
/// las escribe `prisma_seguros`. Aquí se LEEN, con el GRANT por columnas de
/// `prisma/sql/2026-09-21_portal_presupuesto_grants.sql`, más un único
/// `UPDATE(visto_at)`.
///
/// 🚨 **Lo que NO se declara, porque el rol NO lo puede leer** — y si se
/// declarara, la consulta ENTERA reventaría con `permission denied for column`:
///   - `tarificacion_id`  → el origen de los precios es cosa del corredor (el
///     GRANT sí lo tiene, pero solo para que corra el trigger de asegura; ver
///     el SQL).
///   - `creado_por`       → quién lo preparó, dato interno.
///   - `retirado_motivo`  → la nota con la que Alberto lo retira. Puede decir
///     cualquier cosa sobre el cliente y no está escrita para él.
///   - `canal_aviso`, `poliza_emitida_id`, `salida` → no hacen falta para
///     pintar, y lo que no se pide no se puede colar en una pantalla.
///   - `presupuesto_opcion.referencia_vendor` → el id del quote del vendor. Es
///     la llave del ReRate, no un dato del cliente.
model Presupuesto {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correduriaId String    @map("correduria_id") @db.Uuid
  clienteId    String    @map("cliente_id") @db.Uuid
  /// NULL = venta nueva (no hay póliza que comparar), JAMÁS «no tiene seguro».
  polizaId     String?   @map("poliza_id") @db.Uuid
  ramo         String
  /// El token del enlace, HASHEADO. NO abre sesión: dice QUÉ presupuesto es.
  tokenHash    String    @unique @map("token_hash")
  /// A quién se avisó, hasheado con la pimienta del portal. NULL = NO CONSTA.
  destinoHash  String?   @map("destino_hash")
  venceEl      DateTime  @map("vence_el") @db.Timestamptz(6)
  creadoAt     DateTime  @default(now()) @map("creado_at") @db.Timestamptz(6)
  enviadoAt    DateTime? @map("enviado_at") @db.Timestamptz(6)
  /// NULL = NO CONSTA que lo haya abierto. No es «no lo ha abierto».
  vistoAt      DateTime? @map("visto_at") @db.Timestamptz(6)
  elegidoAt    DateTime? @map("elegido_at") @db.Timestamptz(6)
  aceptadoAt   DateTime? @map("aceptado_at") @db.Timestamptz(6)
  emitidoAt    DateTime? @map("emitido_at") @db.Timestamptz(6)
  retiradoAt   DateTime? @map("retirado_at") @db.Timestamptz(6)
  /// Exigencias y necesidades que anotó el corredor (IDD). Es lo que el cliente firma con la aceptación.
  necesidades  String?
  /// `codeoscopic` | `ofertas` (PDFs de compañías: se emite en la compañía, no por Avant2). GRANT
  /// SELECT(origen) en `apps/asegura/prisma/sql/2026-10-05_oportunidad_ofertas.sql`.
  origen       String    @default("codeoscopic")

  opciones PresupuestoOpcion[]
  eventos  PresupuestoEvento[]

  @@map("presupuesto")
  @@schema("seguros")
}

/// SNAPSHOT de lo que se le enseñó, en su orden. No es una vista de
/// `tarificacion_precios`: si el vendor cambia de opinión mañana, lo que se
/// enseñó ese día sigue escrito aquí.
model PresupuestoOpcion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  presupuestoId  String    @map("presupuesto_id") @db.Uuid
  orden          Int       @db.SmallInt
  compania       String
  producto       String
  modalidad      String?
  categoria      String?
  /// NULL = no se pudo clasificar el nivel. No es «sin cobertura».
  grupoCobertura String?   @map("grupo_cobertura")
  primaEur       Decimal   @map("prima_eur") @db.Decimal(10, 2)
  entradaEur     Decimal?  @map("entrada_eur") @db.Decimal(10, 2)
  /// NULL = el producto NO declara franquicia. JAMÁS «sin franquicia».
  franquiciaEur  Decimal?  @map("franquicia_eur") @db.Decimal(10, 2)
  firmeza        String
  requiereRerate Boolean   @map("requiere_rerate")
  /// ⚠️ Vacío (`[]`) significa **no se congelaron**, no «no cubre nada»: el
  /// preparador todavía no las escribe y la columna nace con el default.
  coberturas     Json      @default("[]")
  avisos         Json      @default("[]")
  papeles        String[]  @default([])
  elegidaAt      DateTime? @map("elegida_at") @db.Timestamptz(6)
  /// Fila de `tarificacion_precios` de la que sale (sin FK: aquella se reescribe).
  precioId      String?   @map("precio_id") @db.Uuid
  /// Garantías clasificadas (`clasificarCoberturas`). NULL = no se clasificó.
  garantias     Json?
  /// El corredor la quitó antes de enviar: congelada pero INVISIBLE. Filtra siempre `ocultaAt: null`.
  ocultaAt      DateTime? @map("oculta_at") @db.Timestamptz(6)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@unique([presupuestoId, orden], map: "presupuesto_opcion_orden_unico")
  @@index([presupuestoId, orden])
  @@map("presupuesto_opcion")
  @@schema("seguros")
}

/// Telemetría del presupuesto. APPEND-ONLY por trigger. El portal solo escribe
/// `apertura_ajena` y solo lee para no repetirla en cada recarga.
model PresupuestoEvento {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  presupuestoId String   @map("presupuesto_id") @db.Uuid
  tipo          String
  ocurridoAt    DateTime @default(now()) @map("ocurrido_at") @db.Timestamptz(6)
  origen        String
  /// 🚨 `detalle` NO se declara: el portal no tiene SELECT sobre esa columna
  /// (la escribe el corredor y ahí no hay nada que el portal necesite leer), y
  /// una columna declarada sin GRANT revienta la consulta ENTERA con 42501.
  /// Al no mandarla, la BD aplica su `'{}'::jsonb` por defecto.
  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId, ocurridoAt])
  @@map("presupuesto_evento")
  @@schema("seguros")
}

/// Enlace de acceso directo del correo de avisos: el portal solo lo lee y marca `usado_en`
/// (GRANT de columnas, 24/09/2026). Lo crea asegura.
model PortalEnlaceDirecto {
  id              String    @id @db.Uuid
  emailLookupHash String    @map("email_lookup_hash")
  tokenHash       String    @unique(map: "portal_enlace_directo_token_unico") @map("token_hash")
  destino         String
  expiraEn        DateTime  @map("expira_en") @db.Timestamptz(6)
  usadoEn         DateTime? @map("usado_en") @db.Timestamptz(6)

  @@map("portal_enlace_directo")
  @@schema("seguros")
}

/// Felicitación de cumpleaños que escribe el cron de asegura. El rol solo lee estas tres columnas.
model Felicitacion {
  id        String   @id @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  dia       DateTime @db.Date

  @@map("felicitacion")
  @@schema("seguros")
}

/// Ficha IPID por compañía + producto (tabla de `apps/asegura`, `2026-09-24i_seguros_ipid.sql`). Documento
/// PÚBLICO de la compañía: el portal solo la lee y la sirve dentro del presupuesto del cliente.
model Ipid {
  id            String    @id @db.Uuid
  correduriaId  String    @map("correduria_id") @db.Uuid
  clave         String
  compania      String
  producto      String
  nombreFichero String    @map("nombre_fichero")
  contenido     Bytes
  sha256        String
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  retiradoAt    DateTime? @map("retirado_at") @db.Timestamptz(6)

  @@map("ipid")
  @@schema("seguros")
}

// ════════════════════════════════════════════════════════════════════════════════════════════════
// PATRIMONIO (Fase 1, paso 3, 22/10/2026). DDL: `prisma/sql/2026-10-22_portal_patrimonio.sql` (⛔ SIN APLICAR
// hasta el OK de Alberto; se aplica en el MISMO paso que el despliegue que lo use).
// 🚨 Espejo EXACTO del GRANT SELECT por columnas de cada tabla (cepo `test/regression-portal-patrimonio-sql.test.ts`):
// una columna de más y TODA consulta del modelo cae con 42501. Lo que el rol no INSERTA lleva `dbgenerated`
// (un `@default` de Prisma se rellena en el cliente y nombraría la columna). `actualizadoEn` lo pone un TRIGGER:
// no usar `@updatedAt`. Sin DELETE: se archiva (`archivadoEn`), se anula, se descarta o se desactiva.
// Las FK a tablas ya existentes (clientes, portal_identidad, polizas…) viven en la BD, no como relación Prisma,
// para no tocar esos modelos. Dinero en céntimos `BigInt` (`*Cent`); `null` = «no se sabe», nunca 0.
// Toda lectura parte de `accesosPatrimonio(identidadId)` (paso 4): aquí no hay aislamiento, solo forma.
// ════════════════════════════════════════════════════════════════════════════════════════════════

/// Titular (persona o sociedad) = una ficha de la cartera. Nombre/NIF se leen de `clientes`, no se copian.
/// Trigger: la ficha no puede estar fusionada y `correduriaId` tiene que ser el de la ficha.
model PortalPatrimonioTitular {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId            String    @unique @map("cliente_id") @db.Uuid
  correduriaId         String    @map("correduria_id") @db.Uuid
  tipo                 String
  deduceIva            Boolean?  @map("deduce_iva")
  creadoEn             DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId String?   @map("creado_por_identidad_id") @db.Uuid
  archivadoEn          DateTime? @map("archivado_en") @db.Timestamptz(6)

  inmuebles     PortalPatrimonioInmueble[]
  inquilinos    PortalPatrimonioInquilino[]
  plantillas    PortalPatrimonioPlantillaGasto[]
  gastos        PortalPatrimonioGasto[]
  importaciones PortalPatrimonioImportacion[]
  comunidades   PortalPatrimonioComunidad[]

  @@map("portal_patrimonio_titular")
  @@schema("seguros")
}

/// Inmueble. Dirección por la regla de la casa (CP → municipio INE → vía → número).
model PortalPatrimonioInmueble {
  id                                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titularId                         String    @map("titular_id") @db.Uuid
  alias                             String
  uso                               String
  referenciaCatastral               String?   @map("referencia_catastral") @db.Char(20)
  cp                                String?
  municipioIne                      String?   @map("municipio_ine")
  via                               String?
  numero                            String?
  resto                             String?
  direccionNormalizada              String?   @map("direccion_normalizada")
  superficieM2                      Decimal?  @map("superficie_m2") @db.Decimal(10, 2)
  anioConstruccion                  Int?      @map("anio_construccion")
  enComunidad                       Boolean?  @map("en_comunidad")
  suministros                       String[]  @default(dbgenerated("'{}'::text[]"))
  valorReconstruccionEstimadoCent   BigInt?   @map("valor_reconstruccion_estimado_cent")
  valorReconstruccionEstimadoFuente String?   @map("valor_reconstruccion_estimado_fuente")
  creadoEn                          DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn                     DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId              String?   @map("creado_por_identidad_id") @db.Uuid
  archivadoEn                       DateTime? @map("archivado_en") @db.Timestamptz(6)
  /// «He revisado y no tiene seguro» (24/10/2026, `prisma/sql/2026-10-24_portal_patrimonio_enlace_poliza.sql`).
  /// 🚨 NULL = no lo ha dicho, que NO es «no tiene» (`estadoSeguroInmueble` de `@central/module-patrimonio`).
  /// ⚠️ Declarada ANTES de que exista en la BD = 42703 en toda lectura del modelo: el SQL va antes del despliegue.
  sinSeguroDeclaradoEn              DateTime? @map("sin_seguro_declarado_en") @db.Timestamptz(6)
  sinSeguroDeclaradoPorIdentidadId  String?   @map("sin_seguro_declarado_por_identidad_id") @db.Uuid
  /// Caché del Catastro (25/10/2026, `prisma/sql/2026-10-25_portal_patrimonio_catastro_comunidad.sql`): NULL = no se sabe (≠ 0).
  /// ⚠️ Declarada ANTES de que exista en la BD = 42703 en toda lectura del modelo: el SQL va antes del despliegue.
  catastroSuperficieM2              Decimal?  @map("catastro_superficie_m2") @db.Decimal(10, 2)
  catastroTipoVivienda              String?   @map("catastro_tipo_vivienda")
  catastroConsultadoEn              DateTime? @map("catastro_consultado_en") @db.Timestamptz(6)
  catastroEstado                    String?   @map("catastro_estado")
  /// La persona marca que preside/administra la comunidad. NULL = no lo ha dicho (≠ false).
  presidenteComunidad               Boolean?  @map("presidente_comunidad")
  /// «¿Tiene hipoteca?» (25/10/2026, `prisma/sql/2026-10-25_portal_patrimonio_hipoteca.sql`): `si` | `no` | `no_se` (CHECK).
  /// 🚨 NULL = no lo ha dicho, que NO es «no tiene». Solo `si` ofrece revisar los seguros de la hipoteca (y solo si pulsa).
  /// ⚠️ Declarada ANTES de que exista en la BD = 42703 en toda lectura del modelo: el SQL va antes del despliegue.
  hipoteca                          String?

  titular      PortalPatrimonioTitular             @relation(fields: [titularId], references: [id])
  comunidades  PortalPatrimonioInmuebleComunidad[]
  contratos    PortalPatrimonioContrato[]
  plantillas   PortalPatrimonioPlantillaGasto[]
  gastos       PortalPatrimonioGasto[]
  obligaciones PortalPatrimonioObligacion[]
  polizas      PortalPatrimonioInmueblePoliza[]

  @@unique([id, titularId])
  @@map("portal_patrimonio_inmueble")
  @@schema("seguros")
}

/// Comunidad de propietarios de UN titular, NO compartida (Alberto, 22/10/2026): un vecino nunca lee ni edita
/// la ficha de otro; dos clientes de la misma comunidad = dos filas (el cruce, en /correduria, más adelante).
model PortalPatrimonioComunidad {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titularId            String    @map("titular_id") @db.Uuid
  nombre              String
  nifComunidad         String?   @map("nif_comunidad")
  administradorNombre  String?   @map("administrador_nombre")
  administradorEmail   String?   @map("administrador_email")
  cp                   String?
  direccionNormalizada String?   @map("direccion_normalizada")
  creadoEn             DateTime  @default(dbgenerated("now()")) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(dbgenerated("now()")) @map("actualizado_en") @db.Timestamptz(6)
  creadoPorIdentidadId String?   @map("creado_por_identidad_id") @db.Uuid
  archivadoEn          DateTime? @map("archivado_en") @db.Timestamptz(6)

