{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardian-rama.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardian-rama.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "SENTINEL_SHADOW=on python3 \"$CLAUDE_PROJECT_DIR/.claude/mcp-sentinel/hooks/sentinel_preflight.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys; d=json.load(sys.stdin); c=d.get('tool_input',{}).get('command',''); out={'hookSpecificOutput':{'hookEventName':'PreToolUse','permissionDecision':'ask','permissionDecisionReason':'TEST: ask forzado por hook experimental'}} if 'ASK_TEST_MARKER_XYZ' in c else {}; print(json.dumps(out))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
