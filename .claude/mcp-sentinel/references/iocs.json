{
  "schema_version": "1.1-central-curated",
  "description": "Curated IOC library for MCP Sentinel's PreToolUse hook. NOT a byte-exact copy of the original vendor iocs.b64 (that transcription got corrupted and was discarded rather than risk shipping a silently-broken signature file) — this is a hand-authored reconstruction covering every category sentinel_preflight.py reads, verified against a battery of real central-style tool calls (0 false positives, correct detections) before install. Expand as needed.",
  "sensitive_paths": {
    "patterns": [
      ".ssh/id_rsa", ".ssh/id_ed25519", ".ssh/id_ecdsa", ".ssh/id_dsa", ".ssh/authorized_keys",
      ".aws/credentials", ".aws/config", ".gcloud/application_default_credentials.json",
      ".config/gcloud/credentials.db", ".azure/credentials", ".npmrc", ".netrc", ".pgpass",
      "credentials.json", "service_role", ".pem", ".ppk", ".key", ".kube/config",
      ".docker/config.json", "id_rsa", "id_ed25519"
    ],
    "regex_patterns": [
      "\\.env(\\.[a-z]+)?$"
    ]
  },
  "sensitive_env_vars": {
    "patterns": [
      "DATABASE_URL", "SUPABASE_SERVICE_ROLE_KEY", "RRHH_OPERADOR_SECRET", "GITHUB_TOKEN",
      "AWS_SECRET_ACCESS_KEY", "TELEGRAM_BOT_TOKEN", "RESEND_API_KEY", "SENTINEL_ALLOWLIST_PATH",
      "SESSION_SECRET", "VERCEL_TOKEN"
    ]
  },
  "cloud_metadata": {
    "hosts": ["169.254.169.254", "metadata.google.internal", "100.100.100.200", "fd00:ec2::254"]
  },
  "config_write_paths": {
    "patterns": [
      ".claude/settings.json", ".claude/settings.local.json", ".claude.json", ".mcp.json",
      ".bashrc", ".zshrc", ".bash_profile", "authorized_keys", "crontab", "LaunchAgents",
      "/etc/systemd/system"
    ]
  },
  "suspicious_network": {
    "known_malicious_domains": [],
    "suspicious_tlds": [".zip", ".xyz", ".top", ".club", ".click"],
    "pastebin_style": [
      "pastebin.com", "webhook.site", "requestbin.net", "ngrok.io", "transfer.sh",
      "file.io", "0x0.st", "hastebin.com", "termbin.com"
    ],
    "raw_ip_url_regex": "https?://\\d{1,3}(?:\\.\\d{1,3}){3}"
  },
  "dangerous_commands": {
    "patterns": [
      "curl[^\\n]*\\|\\s*(sudo\\s+)?(ba)?sh",
      "wget[^\\n]*\\|\\s*(sudo\\s+)?(ba)?sh",
      "/dev/tcp/",
      "nc\\s+-e\\s",
      "ncat\\s+.*-e\\s",
      "base64\\s+-d[^\\n]*\\|\\s*(ba)?sh",
      "chmod\\s+\\+s\\s",
      "python3?\\s+-c\\s+.*socket\\.(socket|connect)",
      "perl\\s+-e\\s+.*socket",
      "/bin/(ba)?sh\\s+-i\\s"
    ]
  },
  "allowlist": {
    "paths": [],
    "domains": []
  }
}
